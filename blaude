#!/bin/bash
# blaude - Run Claude Code in a bubblewrap sandbox.
# Options not listed in README.md are passed through to claude.

# Check for bwrap (capture path for later reuse — overlay-support mtime check needs it)
_bwrap_bin=$(command -v bwrap)
if [[ -z "$_bwrap_bin" ]]; then
    echo "Error: bubblewrap (bwrap) is not installed" >&2
    echo "Install with: apt install bubblewrap  OR  dnf install bubblewrap" >&2
    exit 1
fi

# Check for claude
if ! command -v claude &>/dev/null; then
    echo "Error: claude is not installed or not in PATH" >&2
    echo "Install from: https://docs.anthropic.com/en/docs/claude-code" >&2
    exit 1
fi
# Commands that must run outside the sandbox (need write access to system paths).
# DISABLE_UPDATES (Claude Code 2.1.118+) is enforced by claude itself via the
# inherited host env — no host-side guard needed; claude prints its own message.
if [[ "${1:-}" =~ ^(update|install|install-github-app)$ ]]; then
    exec claude "$@"
fi

# AppArmor detection (shared by fix-apparmor subcommand and startup warning)
_apparmor_present() {
    [[ -d /sys/module/apparmor ]] && command -v apparmor_parser &>/dev/null
}
_apparmor_restricts_userns() {
    [[ -f /proc/sys/kernel/apparmor_restrict_unprivileged_userns ]] || return 1
    [[ "$(< /proc/sys/kernel/apparmor_restrict_unprivileged_userns)" == "1" ]]
}

# fix-apparmor: install AppArmor profile to allow bwrap user namespaces (Ubuntu 24.04+)
if [[ "${1:-}" == "fix-apparmor" ]]; then
    if ! _apparmor_present; then
        echo "AppArmor is not active on this system. No fix needed." >&2
        exit 0
    fi
    if [[ -f /etc/apparmor.d/bwrap ]]; then
        echo "AppArmor bwrap profile already exists at /etc/apparmor.d/bwrap" >&2
        exit 0
    fi
    if ! _apparmor_restricts_userns; then
        echo "Unprivileged user namespaces are not restricted. No fix needed." >&2
        exit 0
    fi
    echo "Installing AppArmor profile for bwrap..."
    if sudo tee /etc/apparmor.d/bwrap > /dev/null <<'APPARMOR'
abi <abi/4.0>,
include <tunables/global>

profile bwrap /usr/bin/bwrap flags=(unconfined) {
  userns,

  include if exists <local/bwrap>
}
APPARMOR
    then
        if sudo apparmor_parser -r /etc/apparmor.d/bwrap; then
            echo "AppArmor bwrap profile installed and loaded successfully."
        else
            echo "Error: Failed to load AppArmor bwrap profile." >&2
            exit 1
        fi
    else
        echo "Error: Failed to write AppArmor bwrap profile (sudo required)." >&2
        exit 1
    fi
    exit 0
fi

current_dir=$PWD
dir_name="${current_dir##*/}"
_host_uid=$EUID
_host_gid=${GROUPS[0]}
# Sanitize directory name (colons can cause issues in bwrap mount paths)
safe_dir_name="${dir_name//:/-}"

# Sandbox UID: root is remapped to 1000 (required for --dangerously-skip-permissions)
if [[ $_host_uid -eq 0 ]]; then
    sandbox_uid=1000
    sandbox_gid=1000
else
    sandbox_uid=$_host_uid
    sandbox_gid=$_host_gid
fi

env_args=()
mount_args=()
command_args=()
tmp_mode=false
no_network=false
git_mode=false
ssh_mode=false
aws_mode=false
keyring_mode=false
keep_env_mode=false
allow_protected_writes=false
debug=false
dry_run=false
exec_mode=false
chic_mode=false
clear_tmp_mode=false
no_clipboard=false

# Session-cache a boolean result at /tmp/blaude-<key>-$UID to avoid repeated
# proc/help checks within a session. Compute fn must set _CACHED_BOOL_RESULT.
# Result is returned via the global _CACHED_BOOL_RESULT — assigning instead of
# printing avoids the $(...) fork on every cache hit.
# Optional 3rd arg: invalidate cache when that path is newer (stat via bash -nt,
# no fork) — used by callers whose answer can change when a binary is upgraded.
_CACHED_BOOL_RESULT=""
_cached_bool() {
    local key="$1" compute_fn="$2" invalidate_path="${3:-}"
    local cache="/tmp/blaude-${key}-${_host_uid}"
    if [[ -f "$cache" ]] && \
       { [[ -z "$invalidate_path" ]] || [[ ! "$invalidate_path" -nt "$cache" ]]; }; then
        IFS= read -r _CACHED_BOOL_RESULT < "$cache"
        return
    fi
    "$compute_fn"
    printf '%s\n' "$_CACHED_BOOL_RESULT" > "$cache" 2>/dev/null || true
}

# ${var,,} lowercases — matches `grep -i` semantics without shopt manipulation.
_detect_wsl() {
    local osrelease="" version=""
    [[ -r /proc/sys/kernel/osrelease ]] && IFS= read -r osrelease < /proc/sys/kernel/osrelease
    [[ -r /proc/version ]] && IFS= read -r version < /proc/version
    if [[ "${osrelease,,}" == *microsoft* || "${version,,}" == *microsoft* ]]; then
        _CACHED_BOOL_RESULT=true
    else
        _CACHED_BOOL_RESULT=false
    fi
}
_cached_bool wsl _detect_wsl
wsl_mode=$_CACHED_BOOL_RESULT

# Find asciinema's PID by walking ancestor processes via /proc.
_find_asciinema_pid() {
    local pid ppid key val _
    pid=$$
    while [[ $pid -gt 1 ]]; do
        ppid=
        while IFS=$':\t ' read -r key val _; do
            [[ "$key" == "PPid" ]] && ppid=$val && break
        done < /proc/$pid/status 2>/dev/null
        [[ -z "$ppid" || "$ppid" == "0" ]] && return 1
        if [[ "$(< /proc/$ppid/comm 2>/dev/null)" == "asciinema" ]]; then
            echo "$ppid"
            return 0
        fi
        pid=$ppid
    done
    return 1
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --env)
            env_args+=("$2")
            shift 2
            ;;
        -m|--mount)
            mount_args+=("$2")
            shift 2
            ;;
        --no-network)
            no_network=true
            shift
            ;;
        --git)
            git_mode=true
            shift
            ;;
        --ssh)
            ssh_mode=true
            shift
            ;;
        --aws)
            aws_mode=true
            shift
            ;;
        --keyring)
            keyring_mode=true
            shift
            ;;
        --keep-env)
            keep_env_mode=true
            shift
            ;;
        --allow-protected-writes)
            allow_protected_writes=true
            shift
            ;;
        --tmp)
            tmp_mode=true
            shift
            ;;
        --clear-tmp)
            clear_tmp_mode=true
            shift
            ;;
        --debug)
            debug=true
            shift
            ;;
        --dry-run)
            dry_run=true
            debug=true
            shift
            ;;
        --exec)
            exec_mode=true
            shift
            command_args=("$@")
            break
            ;;
        --chic)
            chic_mode=true
            shift
            ;;
        --no-clipboard)
            no_clipboard=true
            shift
            ;;
        *)
            command_args+=("$1")
            shift
            ;;
    esac
done

# Post-parsing bypass: catch install/update commands after blaude flags
# (e.g., "./blaude --debug install" where $1 was --debug, not install)
if [[ ${#command_args[@]} -gt 0 && "${command_args[0]}" =~ ^(update|install|install-github-app)$ ]]; then
    exec claude "${command_args[@]}"
fi

# --- Ensure Claude config has required flags ---

config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
required_flags='{"hasCompletedOnboarding": true, "bypassPermissionsModeAccepted": true}'

have_jq=""  # lazy: probed on first merge_config_flags fallthrough

merge_config_flags() {
    local file="$1" dir="${1%/*}"
    [[ -d "$dir" ]] || mkdir -p "$dir"
    if [[ ! -f "$file" ]]; then
        echo "$required_flags" > "$file"
        return
    fi
    # Cheap pre-check avoids forking jq (and two greps) on every launch when flags
    # are already set. Slurp the file once and regex-match both flags via bash;
    # false negatives (unusual JSON formatting) fall through to the jq path.
    local contents re1='"hasCompletedOnboarding"[[:space:]]*:[[:space:]]*true'
    local re2='"bypassPermissionsModeAccepted"[[:space:]]*:[[:space:]]*true'
    contents=$(< "$file")
    [[ "$contents" =~ $re1 && "$contents" =~ $re2 ]] && return
    [[ -z "$have_jq" ]] && { command -v jq &>/dev/null && have_jq=true || have_jq=false; }
    [[ "$have_jq" == true ]] || return
    jq -e '.hasCompletedOnboarding == true and .bypassPermissionsModeAccepted == true' "$file" >/dev/null 2>&1 && return
    jq -s '.[0] * .[1]' "$file" <(echo "$required_flags") > "${file}.tmp" && mv "${file}.tmp" "$file"
}

# Update both config locations (Claude Code may read from either).
# Guard the second call in case CLAUDE_CONFIG_DIR=$HOME — then both paths collapse
# to the same file and the second merge would be redundant.
merge_config_flags "$config_dir/.claude.json"
[[ "$config_dir/.claude.json" != "$HOME/.claude.json" ]] && \
    merge_config_flags "$HOME/.claude.json"

# Warn if any settings file disables bypass-permissions mode — blaude always
# passes --dangerously-skip-permissions, so this would silently downgrade to
# default mode. We can't override managed-settings.json (enterprise-controlled).
# No 2>/dev/null on $(< file): that breaks the bash file-read optimization and
# silently returns empty. Existence + readability check is sufficient.
_disable_re='"disableBypassPermissionsMode"[[:space:]]*:[[:space:]]*"disable"'
_settings_files=("$config_dir/settings.json" /etc/claude-code/managed-settings.json)
[[ "$config_dir/settings.json" != "$HOME/.claude/settings.json" ]] && \
    _settings_files+=("$HOME/.claude/settings.json")
# managed-settings.d/ drop-in directory (Claude Code 2.1.83+); fragments merge alphabetically.
if [[ -d /etc/claude-code/managed-settings.d ]]; then
    for _f in /etc/claude-code/managed-settings.d/*.json; do
        [[ -f "$_f" ]] && _settings_files+=("$_f")
    done
fi
for _settings_file in "${_settings_files[@]}"; do
    [[ -f "$_settings_file" && -r "$_settings_file" ]] || continue
    [[ "$(< "$_settings_file")" =~ $_disable_re ]] || continue
    echo "Warning: $_settings_file sets permissions.disableBypassPermissionsMode=\"disable\"." >&2
    echo "  This blocks --dangerously-skip-permissions which blaude always passes." >&2
    if [[ "$_settings_file" == /etc/claude-code/* ]]; then
        echo "  This is an enterprise-managed setting and can only be changed by your admin." >&2
    else
        echo "  Remove the key to restore bypass mode." >&2
    fi
    break  # one warning is enough
done
unset _disable_re _settings_files _settings_file _f

# --- Build bwrap command ---

bwrap_args=(
    # Lifecycle & security
    --cap-drop ALL
    --die-with-parent
    # Note: --new-session removed to allow proper signal propagation for MCP servers
    # and background tasks. PID namespace provides equivalent process isolation.
    # Namespace isolation
    --unshare-pid --unshare-ipc --unshare-uts
    --hostname blaude
)

bwrap_args+=(--unshare-user --uid "$sandbox_uid" --gid "$sandbox_gid")

# --- Mount helpers ---
# Bind <path> at its own location if it exists.
# kind: f (file), d (directory), or e (exists — for symlinks etc.)
# mode: ro-bind or bind
_bind_if_exists() {
    local path="$1" kind="$2" mode="$3"
    [[ -z "$path" ]] && return
    case "$kind" in
        f) [[ -f "$path" ]] || return ;;
        d) [[ -d "$path" ]] || return ;;
        e) [[ -e "$path" ]] || return ;;
        *) echo "_bind_if_exists: invalid kind '$kind'" >&2; exit 1 ;;
    esac
    case "$mode" in
        bind|ro-bind) ;;
        *) echo "_bind_if_exists: invalid mode '$mode'" >&2; exit 1 ;;
    esac
    bwrap_args+=(--"$mode" "$path" "$path")
}
# Ensure directory exists (creating if needed), then bind-mount at its own location.
_ensure_and_bind() {
    local path="$1" mode="$2"
    [[ -d "$path" ]] || mkdir -p "$path" 2>/dev/null
    _bind_if_exists "$path" d "$mode"
}
_dbg() { [[ "$debug" == true ]] && echo "$@" >&2; }

# Refuse $HOME as mount target or workspace unless --allow-protected-writes.
# action: short verb-phrase inserted into the error message ("mount ...",
# "sandbox home directory as workspace", etc.). extra: optional extra hint line
# (defaults to "Use --allow-protected-writes to override.").
_reject_if_home() {
    local resolved="$1" action="$2" extra="${3:-Use --allow-protected-writes to override.}"
    [[ "$allow_protected_writes" == true ]] && return
    [[ "$resolved" != "$HOME" ]] && return
    echo "Error: Refusing to $action." >&2
    echo "  $extra" >&2
    exit 1
}

# Warn about symlinks inside <root> whose targets escape it. bwrap mounts
# don't follow these, but if the target happens to be writable via another
# mount (e.g. -m ~/secrets:rw), Claude could traverse the link unexpectedly.
# Skips in-tree targets and known-safe system paths.
# Pruned dirs (node_modules etc.) keep cold-cache scan sub-second on monorepos.
_scan_workspace_symlinks() {
    local root="$1" link target rel header_shown=false
    while IFS= read -r -d '' link; do
        # -m resolves the path even if the target is missing — broken symlinks
        # are still a smell (target may appear later via mount/race).
        target=$(readlink -m "$link" 2>/dev/null) || continue
        [[ -z "$target" ]] && continue
        case "$target" in
            "$root"|"$root"/*) continue ;;
            /usr/*|/lib/*|/lib32/*|/lib64/*|/bin/*|/sbin/*) continue ;;
            /etc/*|/proc/*|/sys/*|/dev/*) continue ;;
        esac
        if [[ "$header_shown" == false ]]; then
            echo "Warning: workspace contains symlinks pointing outside the tree:" >&2
            header_shown=true
        fi
        rel="${link#"$root"/}"
        printf '  %s -> %s\n' "$rel" "$target" >&2
    done < <(find "$root" -maxdepth 4 \
                 \( -name node_modules -o -name .git -o -name target \
                    -o -name dist -o -name build -o -name .venv \
                    -o -name vendor -o -name __pycache__ \) -prune \
                 -o -type l -print0 2>/dev/null)
}

# System mounts (read-only)
bwrap_args+=(--ro-bind /usr /usr)
_bind_if_exists /lib d ro-bind
_bind_if_exists /lib64 d ro-bind
_bind_if_exists /lib32 d ro-bind
bwrap_args+=(--ro-bind /bin /bin)
_bind_if_exists /sbin d ro-bind
# Mount /etc read-only, but handle resolv.conf symlink specially for WSL2/systemd
# bwrap's --file and bind mounts follow symlinks, so if /etc/resolv.conf is a symlink
# to e.g. /run/systemd/resolve/stub-resolv.conf, we need to create that target path
# See: https://github.com/containers/bubblewrap/issues/390
# Note: The actual symlink target mount is added AFTER base args (--tmpfs /run) below
_blaude_cleanup() {
    [[ -n "$resolv_tmp" ]] && rm -f "$resolv_tmp"
}
trap '_blaude_cleanup' EXIT

resolv_symlink_target=""
resolv_tmp=""
_setup_resolv() {
    [[ -L /etc/resolv.conf ]] || return
    # readlink (no -f): need the raw link target to distinguish absolute vs relative.
    local resolv_target
    resolv_target=$(readlink /etc/resolv.conf)
    resolv_tmp="/tmp/blaude-resolv-$$"
    if ! cat /etc/resolv.conf > "$resolv_tmp" 2>/dev/null || [[ ! -s "$resolv_tmp" ]]; then
        rm -f "$resolv_tmp"
        resolv_tmp=""
    elif [[ "$resolv_target" == /* ]]; then
        # Absolute symlink - create target path after --tmpfs /run is added below
        resolv_symlink_target="$resolv_target"
    fi
}
_setup_resolv
bwrap_args+=(--ro-bind /etc /etc)

# Writable overlay for pyenv shims (pyenv init tries to write here)
if [[ -d /usr/share/pyenv/shims ]]; then
    bwrap_args+=(--tmpfs /usr/share/pyenv/shims)
fi

bwrap_args+=(
    --dev /dev
    --proc /proc
)
# /tmp: bind host's /tmp by default, use tmpfs with --clear-tmp
if [[ "$clear_tmp_mode" == true ]]; then
    bwrap_args+=(--tmpfs /tmp)
else
    bwrap_args+=(--bind /tmp /tmp)
fi
bwrap_args+=(
    --tmpfs /var
    --tmpfs /run
    # tmpfs (not --dir) so accidental host re-binds under /run/user/ get blocked.
    # Wayland/PipeWire/D-Bus sockets only appear via explicit later --bind.
    # XDG_RUNTIME_DIR is set after --clearenv (search for it below).
    --tmpfs "/run/user/$sandbox_uid"
)

# D-Bus session bus access (optional, for keytar/GNOME Keyring/Secret Service)
# Disabled by default - MCP servers fall back to file-based token storage
# Enable with --keyring flag if you have GNOME Keyring properly configured
if [[ "$keyring_mode" == true ]]; then
    dbus_socket=""
    if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
        if [[ "$DBUS_SESSION_BUS_ADDRESS" == *"unix:path="* ]]; then
            dbus_socket="${DBUS_SESSION_BUS_ADDRESS#*unix:path=}"
            dbus_socket="${dbus_socket%%,*}"
        elif [[ "$DBUS_SESSION_BUS_ADDRESS" == *"unix:abstract="* ]]; then
            # Surface unconditionally: --keyring was explicitly requested but won't work.
            echo "Warning: D-Bus uses abstract socket (won't work in sandbox)" >&2
        fi
    fi
    [[ -z "$dbus_socket" ]] && dbus_socket="/run/user/$_host_uid/bus"

    if [[ -S "$dbus_socket" ]]; then
        bwrap_args+=(--bind "$dbus_socket" "$dbus_socket")
        _dbg "Binding D-Bus session socket: $dbus_socket"
    fi
fi

# Complete resolv.conf symlink handling (deferred from above, after --tmpfs /run)
if [[ -n "$resolv_symlink_target" ]]; then
    # Create the symlink target directory and mount our content there
    bwrap_args+=(--dir "${resolv_symlink_target%/*}")
    bwrap_args+=(--ro-bind "$resolv_tmp" "$resolv_symlink_target")
elif [[ -n "$resolv_tmp" ]]; then
    # Relative symlink case - bind mount over /etc/resolv.conf
    bwrap_args+=(--ro-bind "$resolv_tmp" /etc/resolv.conf)
fi

# Handle custom temp directory if CLAUDE_CODE_TMPDIR is set
# Claude appends /claude/ to this path for its temp files
if [[ -n "${CLAUDE_CODE_TMPDIR:-}" && "$CLAUDE_CODE_TMPDIR" != "/tmp" ]]; then
    # Ensure the custom tmpdir is writable inside the sandbox
    bwrap_args+=(--tmpfs "$CLAUDE_CODE_TMPDIR")
fi

# Minimal home exposure: tmpfs $HOME with scaffolded writable dirs
# (pkg managers, caches — ephemeral, cleared on sandbox exit).
bwrap_args+=(--tmpfs "$HOME")
for _d in .local .local/bin .local/share .local/lib \
          .cache go go/bin go/pkg .cargo .cargo/bin .cargo/registry; do
    bwrap_args+=(--dir "$HOME/$_d")
done
unset _d

# GNOME Keyring storage (optional, only with --keyring flag)
if [[ "$keyring_mode" == true ]]; then
    keyrings_dir="$HOME/.local/share/keyrings"
    _dbg "Binding GNOME Keyring storage: $keyrings_dir"
    _ensure_and_bind "$keyrings_dir" bind
fi

# npm cache: bind host's cache if it exists (for npx-based MCP servers),
# otherwise seed an ephemeral _cacache subdir.
if [[ -d "$HOME/.npm" ]]; then
    _bind_if_exists "$HOME/.npm" d bind
else
    bwrap_args+=(--dir "$HOME/.npm" --dir "$HOME/.npm/_cacache")
fi

# Bind host's user binaries and their backing virtual environments
# Many tools in ~/.local/bin are symlinks to pipx/uv venvs
bwrap_args+=(--dir /opt)

# Mount a host directory under /opt/<name> (read-only), creating the mount point.
_mount_host_bin() {
    local host="$1" name="$2"
    [[ -d "$host" ]] || return
    bwrap_args+=(--dir "/opt/$name" --ro-bind "$host" "/opt/$name")
}

_mount_host_bin "$HOME/.local/bin" host-bin

# Bind claude binary (Claude Code checks for itself there).
# Uses 'e' kind so symlinks to claude are also bound.
_bind_if_exists "$HOME/.local/bin/claude" e ro-bind

# Bind pipx virtual environments (symlink targets for pipx-installed tools)
_bind_if_exists "$HOME/.local/share/pipx" d ro-bind

# Bind uv tools directory (for uv-installed MCP servers like notebooklm-mcp)
# These are symlink targets for tools in ~/.local/bin installed via `uv tool install`
_bind_if_exists "$HOME/.local/share/uv/tools" d ro-bind

# Bind uv-managed Python installations (some uv tools use these instead of system Python)
_bind_if_exists "$HOME/.local/share/uv/python" d ro-bind

# uv cache: bind if exists for faster tool installs, else leave ephemeral
_bind_if_exists "$HOME/.cache/uv" d bind

# Resolve symlinks under a package manager directory, find their package roots,
# and mount them read-only. Also mounts MCP token files read-write for persistence.
# Results are cached across launches; rebuild when scan_root's mtime is newer than
# the cache file (the readlink -f fork per symlink is the dominant startup cost on
# a populated nvm/bun tree). Uses bash's `-nt` (stat(2), no fork) — NOT a `stat -c`
# subshell.
# Cache-key caveat: directory mtime only bumps when direct children change, so a
# new symlink nested deep under scan_root (e.g. a grandchild added by `npm i -g`)
# won't invalidate the cache. Workaround: `rm /tmp/blaude-pkgmount-*-$UID`.
# Usage: _mount_linked_packages <label> <exclude_prefix> <find_args...>
_mount_linked_packages() {
    local label="$1" exclude_prefix="$2"
    shift 2
    local scan_root="$1" scan_key
    scan_key=${scan_root//\//_}
    local cache_file="/tmp/blaude-pkgmount-${label}-${scan_key}-${_host_uid}"
    local -a link_targets=()

    if [[ -f "$cache_file" && ! "$scan_root" -nt "$cache_file" ]]; then
        while IFS= read -r line; do
            [[ -n "$line" ]] && link_targets+=("$line")
        done < "$cache_file"
    else
        local -A seen=()
        while IFS= read -r -d '' symlink; do
            local target
            target=$(readlink -f "$symlink" 2>/dev/null)
            [[ -z "$target" || "$target" == "$exclude_prefix"* ]] && continue
            # Walk up to package root (directory with package.json)
            local link_dir="$target"
            while [[ "$link_dir" != "/" && "$link_dir" != "$HOME" && ! -f "$link_dir/package.json" ]]; do
                link_dir=${link_dir%/*}
                [[ -z "$link_dir" ]] && link_dir=/
            done
            if [[ -f "$link_dir/package.json" && "$link_dir" != "$HOME" && -z "${seen[$link_dir]:-}" ]]; then
                seen[$link_dir]=1
                link_targets+=("$link_dir")
            fi
        done < <(find "$@" -print0 2>/dev/null)
        printf '%s\n' "${link_targets[@]}" > "$cache_file" 2>/dev/null || true
    fi

    for link_target in "${link_targets[@]}"; do
        _dbg "Auto-mounting ${label}-linked package: $link_target"
        bwrap_args+=(--ro-bind "$link_target" "$link_target")
        # MCP token files — create if needed for bind mount, mount read-write for persistence
        for token_file in ".token-cache.json" ".selected-account.json"; do
            local token_path="$link_target/$token_file"
            [[ ! -f "$token_path" ]] && : > "$token_path" 2>/dev/null
            if [[ -f "$token_path" ]]; then
                _dbg "  Mounting token file read-write: $token_path"
                bwrap_args+=(--bind "$token_path" "$token_path")
            fi
        done
    done
}

# Bind NVM (Node Version Manager) for npx-based MCP servers
# NVM installs Node.js to ~/.nvm/versions/node/<version>/
nvm_installed=false
if [[ -d "$HOME/.nvm" ]]; then
    nvm_installed=true
    _bind_if_exists "$HOME/.nvm" d ro-bind
    _mount_linked_packages "npm" "$HOME/.nvm" \
        "$HOME/.nvm/versions" -type l -path "*/node_modules/*"
fi

_mount_host_bin "$HOME/.cargo/bin" host-cargo-bin
_mount_host_bin "$HOME/go/bin" host-go-bin

# Bind claude's data directory read-only if it exists
# DISABLE_AUTOUPDATER=1 is set below, so no write access needed
_bind_if_exists "$HOME/.local/share/claude" d ro-bind

# Ensure config directory exists on host, then bind-mount (bwrap --bind auto-creates DEST)
_ensure_and_bind "$config_dir" bind

# Mount ~/.claude.json (OAuth session, MCP servers, preferences, caches)
_bind_if_exists "$HOME/.claude.json" f bind

# claudechic config file (~/.claude/.claudechic.yaml) is already accessible
# via the config_dir mount above — do NOT bind-mount it directly, as claudechic
# uses atomic writes (os.replace) which fail on bind-mounted files.

# claudechic debug log (only needed if CLAUDECHIC_DEBUG is set)
if [[ -n "${CLAUDECHIC_DEBUG:-}" ]]; then
    claudechic_log="$HOME/claudechic.log"
    [[ -f "$claudechic_log" ]] || : > "$claudechic_log" 2>/dev/null
    _bind_if_exists "$claudechic_log" f bind
fi

# notebooklm-mcp auth directories (token cache, Chrome profiles, config)
for notebooklm_dir in "$HOME/.notebooklm-mcp" "$HOME/.notebooklm-mcp-cli"; do
    _ensure_and_bind "$notebooklm_dir" bind
done

# User config directory (~/.config/)
# Includes uv config (python-preference), fabric, google-chrome, and other tool configs
_bind_if_exists "$HOME/.config" d bind

# arxiv-storage directory (for research paper management tools)
_bind_if_exists "$HOME/arxiv-storage" d bind

# Claude memory directory (for persistent memory across sessions)
# Auto-create if claude-mem plugin is installed but data dir doesn't exist yet
if [[ ! -d "$HOME/.claude-mem" ]]; then
    if [[ -d "$config_dir/plugins/marketplaces/thedotmack" || \
          -d "$config_dir/plugins/cache/claude-mem" ]]; then
        mkdir -p "$HOME/.claude-mem"
    elif [[ -r "$config_dir/plugins/installed_plugins.json" ]] && \
         [[ "$(< "$config_dir/plugins/installed_plugins.json")" == *\"claude-mem\"* ]]; then
        mkdir -p "$HOME/.claude-mem"
    fi
fi
_bind_if_exists "$HOME/.claude-mem" d bind

# Bun runtime and package manager
if [[ -d "$HOME/.bun" ]]; then
    _bind_if_exists "$HOME/.bun" d ro-bind
    # Bun runtime needs writable install cache (plugins like claude-mem run bun install)
    [[ -d "$HOME/.bun/install/cache" ]] && bwrap_args+=(--tmpfs "$HOME/.bun/install/cache")
    # Scan bin/ and global node_modules/ separately to avoid traversing ~/.bun/install/cache
    _mount_linked_packages "bun" "$HOME/.bun" \
        "$HOME/.bun/bin" -type l
    _mount_linked_packages "bun" "$HOME/.bun" \
        "$HOME/.bun/install/global/node_modules" -type l
fi

# Network isolation
if [[ "$no_network" == true ]]; then
    bwrap_args+=(--unshare-net)
fi

# Bind a file/dir named by an env var, if set and existing, at its host path.
# kind: f (file) or d (directory); mode: ro-bind or bind
_bind_env_path() { _bind_if_exists "${!1:-}" "$2" "$3"; }

# Add --setenv VAR=<host value> to bwrap_args iff VAR is set and non-empty.
_setenv_if_set() { [[ -n "${!1:-}" ]] && bwrap_args+=(--setenv "$1" "${!1}"); }

# Git mode: mount git config, GPG agent socket dir, and pass GitHub tokens
if [[ "$git_mode" == true ]]; then
    _bind_if_exists "$HOME/.gitconfig" f ro-bind
    _bind_if_exists "$HOME/.git-credentials" f ro-bind
    # GPG agent socket (for signed commits with commit.gpgsign=true).
    # gpgconf is the canonical way to discover the socket dir — handles
    # XDG_RUNTIME_DIR/gnupg vs ~/.gnupg vs custom GNUPGHOME transparently.
    if command -v gpgconf &>/dev/null; then
        _bind_if_exists "$(gpgconf --list-dirs socketdir 2>/dev/null)" d bind
    fi
    # GNUPGHOME may point to a non-default keyring location — mount read-only.
    _bind_env_path GNUPGHOME d ro-bind
    # GitHub tokens (for gh CLI, git push/pull, MCP servers)
    for var in GH_TOKEN GITHUB_TOKEN; do
        _setenv_if_set "$var"
    done
fi

# SSH mode: mount SSH keys and forward SSH agent
if [[ "$ssh_mode" == true ]]; then
    _bind_if_exists "$HOME/.ssh" d ro-bind
    # Bind the socket's parent dir so socket re-creation by systemd-tmpfile
    # (e.g. after `systemctl --user restart ssh-agent`) stays visible.
    [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]] && \
        _bind_if_exists "${SSH_AUTH_SOCK%/*}" d bind
fi

# AWS mode: mount AWS config/credentials for Bedrock authentication
if [[ "$aws_mode" == true ]]; then
    _bind_if_exists "$HOME/.aws" d ro-bind
fi

# Files (mTLS, CA bundles, token files, env file, GCP creds) — read-only.
# GOOGLE_APPLICATION_CREDENTIALS is Vertex-facing and shouldn't require --aws.
for var in CLAUDE_ENV_FILE CLAUDE_CODE_CLIENT_CERT CLAUDE_CODE_CLIENT_KEY \
           AWS_WEB_IDENTITY_TOKEN_FILE NODE_EXTRA_CA_CERTS \
           GOOGLE_APPLICATION_CREDENTIALS; do
    _bind_env_path "$var" f ro-bind
done

# Directories — read-only (skill dir is inert data)
_bind_env_path CLAUDE_SKILL_DIR d ro-bind

# Directories — read-write
for var in CLAUDE_CODE_PLUGIN_CACHE_DIR CLAUDE_PLUGIN_DATA CLAUDE_CODE_DEBUG_LOGS_DIR \
           CLAUDE_CODE_WORKSPACE_DIR; do
    _bind_env_path "$var" d bind
done

# CLAUDE_CODE_PLUGIN_SEED_DIR: colon-separated list of directories (Claude Code 2.1.79+)
if [[ -n "${CLAUDE_CODE_PLUGIN_SEED_DIR:-}" ]]; then
    IFS=':' read -ra _seed_dirs <<< "$CLAUDE_CODE_PLUGIN_SEED_DIR"
    for _seed_dir in "${_seed_dirs[@]}"; do
        _bind_if_exists "$_seed_dir" d ro-bind
    done
    unset _seed_dirs _seed_dir
fi

# Additional mount points
for mount_spec in "${mount_args[@]}"; do
    # Check for :rw suffix (read-write mode)
    if [[ "$mount_spec" == *":rw" ]]; then
        mount_mode="bind"
        mount_spec="${mount_spec%:rw}"  # Strip :rw suffix
    else
        mount_mode="ro-bind"
    fi

    # Expand ~ to $HOME
    host_path="${mount_spec/#\~/$HOME}"

    if [[ ! -e "$host_path" ]]; then
        echo "Error: Mount path does not exist: $host_path" >&2
        exit 1
    fi

    # Resolve symlinks and validate target
    resolved_path=$(readlink -f "$host_path")
    if [[ -z "$resolved_path" || ! -e "$resolved_path" ]]; then
        echo "Error: Mount path is a broken symlink: $host_path" >&2
        exit 1
    fi
    _reject_if_home "$resolved_path" "mount home directory: $host_path"
    if [[ "$resolved_path" != "$host_path" ]]; then
        echo "Warning: Mount path $host_path is a symlink to $resolved_path" >&2
        echo "  Mounting resolved target instead." >&2
        host_path="$resolved_path"
    fi

    bwrap_args+=(--"$mount_mode" "$host_path" "$host_path")
done

if [[ "$tmp_mode" == true ]]; then
    bwrap_args+=(--chdir /tmp)
else
    # Reject $HOME as workspace (would expose entire home directory read-write).
    # Skip the readlink -f fork entirely when the override is set.
    if [[ "$allow_protected_writes" != true ]]; then
        resolved_workspace=$(readlink -f "$current_dir")
        _reject_if_home "$resolved_workspace" "sandbox home directory as workspace" \
            "Use a subdirectory instead, --tmp, or --allow-protected-writes to override."
    fi

    workspace="/workspaces/$safe_dir_name"
    [[ "$allow_protected_writes" != true ]] && _scan_workspace_symlinks "$current_dir"
    bwrap_args+=(--bind "$current_dir" "$workspace")
    bwrap_args+=(--chdir "$workspace")

    # --- Mandatory protected paths ---
    # Inspired by Anthropic's sandbox-runtime: deny writes to files/directories that
    # could execute code outside the sandbox.
    #
    # Files: --ro-bind (preserves content, hard-blocks writes).
    # Directories: --tmp-overlay when available (content readable, writes ephemeral,
    # zero host artifacts), falling back to --ro-bind (hard-blocks writes but bwrap
    # creates host stubs for non-existent targets). When a protected child directory
    # doesn't exist, its parent is overlaid instead to prevent creation.
    # Root-level dotfiles (.bashrc etc.) have no overlayable parent — only protected
    # if they already exist (low risk: uncommon in project directories).
    if [[ "$allow_protected_writes" != true ]]; then
        # Overlay support added in bwrap 0.8.0. _cached_bool's mtime invalidation
        # (keyed on the bwrap binary) ensures upgrades take effect immediately
        # without forking `bwrap --help | grep` on every launch.
        _detect_overlay() {
            local help
            help=$(bwrap --help 2>&1)
            [[ "$help" == *--tmp-overlay* ]] && _CACHED_BOOL_RESULT=true || _CACHED_BOOL_RESULT=false
        }
        _cached_bool overlay _detect_overlay "$_bwrap_bin"
        if [[ "$_CACHED_BOOL_RESULT" == true ]]; then
            _protect_dir() { bwrap_args+=(--overlay-src "$1" --tmp-overlay "$2"); }
        else
            _protect_dir() { bwrap_args+=(--ro-bind "$1" "$2"); }
        fi
        _protect_file() { bwrap_args+=(--ro-bind "$1" "$2"); }

        for f in .bashrc .bash_profile .zshrc .zprofile .profile \
                 .gitconfig .gitmodules .ripgreprc .mcp.json; do
            [[ -f "$current_dir/$f" ]] && _protect_file "$current_dir/$f" "$workspace/$f"
        done

        # .git/* paths: only protect if .git is a directory (not a file, as in git worktrees)
        if [[ -d "$current_dir/.git" ]]; then
            if [[ -d "$current_dir/.git/hooks" ]]; then
                [[ -f "$current_dir/.git/config" ]] && _protect_file "$current_dir/.git/config" "$workspace/.git/config"
                _protect_dir "$current_dir/.git/hooks" "$workspace/.git/hooks"
            else
                # hooks/ missing — overlay .git/ to prevent hooks/ creation (also covers config)
                _protect_dir "$current_dir/.git" "$workspace/.git"
            fi
        fi

        # .claude/ left writable — skills and agents need to be modifiable

        [[ -d "$current_dir/.vscode" ]] && _protect_dir "$current_dir/.vscode" "$workspace/.vscode"
        [[ -d "$current_dir/.idea" ]]   && _protect_dir "$current_dir/.idea" "$workspace/.idea"

        # Same protection for nested protected paths (monorepos, git submodules,
        # vendored deps). mindepth 2 skips the top-level (already done above).
        # maxdepth 3 catches submodules and one level of vendored deps without
        # exploding scan time on monorepos. Noise dirs (node_modules etc.) are
        # pruned first; then matches are pruned-and-printed so we don't descend.
        _apply_nested_protected() {
            local found rel
            while IFS= read -r found; do
                rel="${found#"$current_dir"/}"
                case "${found##*/}" in
                    .git)
                        if [[ -d "$found/hooks" ]]; then
                            [[ -f "$found/config" ]] && _protect_file "$found/config" "$workspace/$rel/config"
                            _protect_dir "$found/hooks" "$workspace/$rel/hooks"
                        else
                            _protect_dir "$found" "$workspace/$rel"
                        fi
                        ;;
                    .vscode|.idea)
                        _protect_dir "$found" "$workspace/$rel"
                        ;;
                    *)
                        _protect_file "$found" "$workspace/$rel"
                        ;;
                esac
            done < <(
                find "$current_dir" -mindepth 2 -maxdepth 3 \
                    \( -name node_modules -o -name target -o -name dist \
                       -o -name build -o -name .venv -o -name vendor \
                       -o -name __pycache__ \) -prune \
                    -o \
                    \( -type d \( -name .git -o -name .vscode -o -name .idea \) -prune -print \) \
                    2>/dev/null
                find "$current_dir" -mindepth 2 -maxdepth 3 \
                    \( -name node_modules -o -name target -o -name dist \
                       -o -name build -o -name .venv -o -name vendor \
                       -o -name __pycache__ -o -name .git \) -prune \
                    -o \
                    \( -type f \( -name .bashrc -o -name .bash_profile \
                                  -o -name .zshrc -o -name .zprofile -o -name .profile \
                                  -o -name .gitconfig -o -name .gitmodules \
                                  -o -name .ripgreprc -o -name .mcp.json \) -print \) \
                    2>/dev/null
            )
        }
        _apply_nested_protected
    fi
fi

if [[ "$keep_env_mode" != true ]]; then
    bwrap_args+=(--clearenv)
    bwrap_args+=(--setenv HOME "$HOME")
    bwrap_args+=(--setenv USER "${USER:-${LOGNAME:-root}}")
    bwrap_args+=(--setenv TERM "${TERM:-xterm-256color}")
    _setenv_if_set COLORTERM
fi
# XDG_RUNTIME_DIR, PATH, GOPATH, CARGO_HOME, NVM_DIR/NPM_CONFIG_PREFIX below are set
# unconditionally — even under --keep-env — because they must point at sandbox-mounted
# paths (e.g. /opt/host-bin, /run/user/$sandbox_uid) rather than the host's originals.
bwrap_args+=(--setenv XDG_RUNTIME_DIR "/run/user/$sandbox_uid")
sandbox_path="$HOME/.local/bin:$HOME/go/bin:$HOME/.cargo/bin:$HOME/.bun/bin:/opt/host-bin:/opt/host-cargo-bin:/opt/host-go-bin"
# Add NVM bin directory if NVM is installed (for npx, node, npm)
if [[ -n "${NVM_BIN:-}" ]]; then
    sandbox_path="$sandbox_path:$NVM_BIN"
elif [[ "$nvm_installed" == true ]]; then
    # Try to find the current/default node version
    nvm_node_bin=""
    if [[ -f "$HOME/.nvm/alias/default" ]]; then
        # Read default version from alias file (contains version string like "v22.21.1")
        nvm_version=$(< "$HOME/.nvm/alias/default")
        # Handle lts/* aliases (e.g., "lts/iron" -> read actual version from lts alias)
        if [[ "$nvm_version" == lts/* ]]; then
            lts_name="${nvm_version#lts/}"
            [[ -f "$HOME/.nvm/alias/lts/$lts_name" ]] && nvm_version=$(< "$HOME/.nvm/alias/lts/$lts_name")
        fi
        [[ -d "$HOME/.nvm/versions/node/$nvm_version/bin" ]] && nvm_node_bin="$HOME/.nvm/versions/node/$nvm_version/bin"
    fi
    # Fall back to most recently modified node version (globbing avoids parsing ls output).
    if [[ -z "$nvm_node_bin" && -d "$HOME/.nvm/versions/node" ]]; then
        for _nvm_bin in "$HOME/.nvm/versions/node"/*/bin; do
            [[ -d "$_nvm_bin" ]] || continue
            [[ -z "$nvm_node_bin" || "$_nvm_bin" -nt "$nvm_node_bin" ]] && nvm_node_bin="$_nvm_bin"
        done
        unset _nvm_bin
    fi
    [[ -n "$nvm_node_bin" ]] && sandbox_path="$sandbox_path:$nvm_node_bin"
fi
sandbox_path="$sandbox_path:/usr/local/bin:/usr/bin:/bin:/sbin:/usr/sbin"
bwrap_args+=(--setenv PATH "$sandbox_path")
# Package manager environment variables
bwrap_args+=(--setenv GOPATH "$HOME/go")
bwrap_args+=(--setenv CARGO_HOME "$HOME/.cargo")
# NVM environment: set NVM_DIR and skip NPM_CONFIG_PREFIX (NVM manages its own prefix)
if [[ "$nvm_installed" == true ]]; then
    bwrap_args+=(--setenv NVM_DIR "$HOME/.nvm")
else
    bwrap_args+=(--setenv NPM_CONFIG_PREFIX "$HOME/.local")
fi
if [[ "$keep_env_mode" != true ]]; then
    bwrap_args+=(--setenv LANG "${LANG:-C.UTF-8}")
    _setenv_if_set LC_ALL
    _setenv_if_set LC_CTYPE

    # SSH agent forwarding env var
    if [[ "$ssh_mode" == true && -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]]; then
        _setenv_if_set SSH_AUTH_SOCK
    fi
fi

# Hardcoded env-var overrides — KEY=VALUE pairs forced into the sandbox,
# never accepted from host env (the passthrough loop below explicitly removes
# them from the whitelist, so they can't drift if added to claude_env_vars
# by accident). CLAUDE_DISABLE_CONFIG_WATCH prevents inotify ENOSPC crashes.
_hardcoded_env_vars=(
    DO_NOT_TRACK=1 DISABLE_TELEMETRY=1 DISABLE_AUTOUPDATER=1 DISABLE_ERROR_REPORTING=1
    DISABLE_BUG_COMMAND=1 CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY=1
    DISABLE_INSTALL_GITHUB_APP_COMMAND=1 CLAUDE_DISABLE_CONFIG_WATCH=1
)
for _kv in "${_hardcoded_env_vars[@]}"; do
    bwrap_args+=(--setenv "${_kv%%=*}" "${_kv#*=}")
done
unset _kv

# Hardcoded env-var unsets — forced absent regardless of host env.
# CLAUDE_CODE_SUBPROCESS_ENV_SCRUB triggers permission-mode hardening
# whenever defined (even =0), overriding --dangerously-skip-permissions.
_hardcoded_unsetenv_vars=(
    CLAUDE_CODE_SUBPROCESS_ENV_SCRUB
)
for _var in "${_hardcoded_unsetenv_vars[@]}"; do
    bwrap_args+=(--unsetenv "$_var")
done
unset _var

