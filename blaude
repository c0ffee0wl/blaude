# Only passthrough specific vars when environment is cleared (default).
# Single pass over exported env vars, matched against the whitelist set and glob patterns.
if [[ "$keep_env_mode" != true ]]; then
    declare -A _env_whitelist
    for var in "${claude_env_vars[@]}"; do _env_whitelist[$var]=1; done
    # Remove hardcoded vars from the whitelist — they're forced (set or
    # unset) above and must never be overridden from the host env. %%=* is
    # a no-op on the bare-name entries from _hardcoded_unsetenv_vars.
    for _kv in "${_hardcoded_env_vars[@]}" "${_hardcoded_unsetenv_vars[@]}"; do
        unset "_env_whitelist[${_kv%%=*}]"
    done
    unset _kv

    while IFS= read -r name; do
        if [[ -n "${_env_whitelist[$name]:-}" || \
              "$name" == *_WEBHOOK || "$name" == WEBSHARE_* || "$name" == CLAUDE_MEM_* ]]; then
            _setenv_if_set "$name"
        fi
    done < <(compgen -e)
    unset _env_whitelist

    # D-Bus session bus address (only with --keyring flag)
    [[ "$keyring_mode" == true ]] && _setenv_if_set DBUS_SESSION_BUS_ADDRESS
fi

for env_spec in "${env_args[@]}"; do
    key="${env_spec%%=*}"
    value="${env_spec#*=}"
    bwrap_args+=(--setenv "$key" "$value")
done

# --- Build command ---

if [[ "$exec_mode" == true ]]; then
    # --exec: run arbitrary command
    bwrap_args+=("${command_args[@]}")
elif [[ "$chic_mode" == true ]]; then
    # --chic: run claudechic instead of claude
    if [[ ${#command_args[@]} -eq 0 ]]; then
        bwrap_args+=(claudechic --dangerously-skip-permissions)
    else
        bwrap_args+=(claudechic --dangerously-skip-permissions "${command_args[@]}")
    fi
elif [[ ${#command_args[@]} -eq 0 ]]; then
    # No args: interactive claude (or -p for piped input)
    if [[ -t 0 ]]; then
        bwrap_args+=(claude --dangerously-skip-permissions)
    else
        # Piped input with no command - send to claude -p
        bwrap_args+=(claude --dangerously-skip-permissions -p)
    fi
else
    # Pass accumulated args to claude
    bwrap_args+=(claude --dangerously-skip-permissions "${command_args[@]}")
fi

# --- Execute ---

if [[ "$debug" == true ]]; then
    # printf %q emits a shell-safe, copy-pasteable representation for every
    # metacharacter (space, quote, $, `, \, glob chars, ...).
    printf '\e[2mbwrap' >&2
    printf ' %q' "${bwrap_args[@]}" >&2
    printf '\e[0m\n' >&2
fi

if [[ "$dry_run" == true ]]; then
    exit 0
fi

# Pause asciinema recording during the sandbox session
_asciinema_pid=""
if [[ "${ASCIINEMA_REC:-}" == "1" ]]; then
    _asciinema_pid=$(_find_asciinema_pid)
    if [[ -n "$_asciinema_pid" ]]; then
        _dbg "Pausing asciinema (PID $_asciinema_pid)"
    fi
fi

# Auto-detect osc52-clipboard wrapper (intercepts OSC 52 sequences for VTE terminals
# that lack native OSC 52 support, e.g. Terminator, GNOME Terminal, XFCE Terminal)
_clipboard_cmd=""
if [[ "$no_clipboard" != true ]]; then
    # Derive blaude's directory without forking readlink on the common case.
    # readlink is only needed when $0 is a symlink (rare — e.g. installed to
    # /usr/local/bin via `ln -s`).
    if [[ -L "$0" ]]; then
        _blaude_dir=$(readlink -f "$0")
        _blaude_dir=${_blaude_dir%/*}
    elif [[ "$0" == */* ]]; then
        _blaude_dir="${0%/*}"
    else
        _blaude_dir=""  # bare name via PATH — fall through to command -v
    fi
    if [[ -n "$_blaude_dir" && -x "$_blaude_dir/osc52-clipboard" ]]; then
        _clipboard_cmd="$_blaude_dir/osc52-clipboard"
    else
        _clipboard_cmd=$(command -v osc52-clipboard 2>/dev/null || true)
    fi
fi
if [[ -n "$_clipboard_cmd" ]]; then
    _dbg "Clipboard proxy: $_clipboard_cmd"
    final_cmd=("$_clipboard_cmd" bwrap "${bwrap_args[@]}")
else
    final_cmd=(bwrap "${bwrap_args[@]}")
fi

# Detect AppArmor user namespace restriction (Ubuntu 24.04+).
# bwrap needs user namespaces, which AppArmor may block by default.
# _apparmor_restricts_userns requires /proc/sys/kernel/apparmor_restrict_unprivileged_userns
# to exist and be "1" — true only on AppArmor-active systems, so short-circuits for free.
if _apparmor_restricts_userns && [[ ! -f /etc/apparmor.d/bwrap ]]; then
    echo "Warning: AppArmor is restricting unprivileged user namespaces." >&2
    echo "  bwrap may fail with 'Operation not permitted' on this system." >&2
    echo "  Fix with: blaude fix-apparmor" >&2
    echo "" >&2
fi

# WSL2 workarounds: mitigate 9P/drvfs race conditions
# The 9P filesystem used for /mnt/* host mounts has known bugs (still unfixed):
#   - https://github.com/microsoft/WSL/issues/8443 (fstat ENOENT after rename)
#   - https://github.com/microsoft/WSL/issues/13105 (follow-up, still open)
# The only reliable fix is to use the native ext4 filesystem (/home/...) instead.
if [[ "$wsl_mode" == true ]]; then
    _dbg "WSL2 detected: applying workarounds"

    # Warn if workspace is on Windows filesystem (9P) - once per session
    wsl_mnt_warned="/tmp/blaude-mnt-warned-${_host_uid}"
    if [[ "$current_dir" == /mnt/* && ! -f "$wsl_mnt_warned" ]]; then
        echo "Warning: Workspace is on Windows filesystem (/mnt/*)." >&2
        echo "  WSL2's 9P protocol has known bugs causing spurious ENOENT errors." >&2
        echo "  For best reliability, move your project to the Linux filesystem:" >&2
        echo "  e.g., /home/\$USER/projects/ instead of /mnt/c/..." >&2
        echo "" >&2
        read -n 1 -s -r -p "Press any key to continue..." >&2
        echo "" >&2
        : > "$wsl_mnt_warned" 2>/dev/null || true
    fi

    sync
fi

# Non-exec path: WSL2 needs post-bwrap sync, asciinema needs post-bwrap SIGCONT.
# Both require blaude to stay alive after bwrap exits, so we can't exec.
if [[ "$wsl_mode" == true || -n "${_asciinema_pid:-}" ]]; then
    _blaude_exit() {
        _blaude_cleanup
        [[ "$wsl_mode" == true ]] && sync
        [[ -n "${_asciinema_pid:-}" ]] && kill -CONT "$_asciinema_pid" 2>/dev/null
    }
    trap _blaude_exit EXIT
    [[ -n "${_asciinema_pid:-}" ]] && kill -STOP "$_asciinema_pid" 2>/dev/null
    "${final_cmd[@]}"
    exit $?
fi

# Clean up temp files before exec (exec replaces the process, so traps won't fire)
_blaude_cleanup
exec "${final_cmd[@]}"
