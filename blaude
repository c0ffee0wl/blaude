#!/bin/bash
# blaude - Run Claude Code in a bubblewrap sandbox
# All options except blaude-specific ones are passed directly to claude.
# See README.md for blaude options: --env, -m/--mount, --git, --ssh, --aws,
# --no-network, --tmp, --clear-tmp, --keep-env, --debug, --dry-run, --exec

# Check for bwrap
if ! command -v bwrap &>/dev/null; then
    echo "Error: bubblewrap (bwrap) is not installed" >&2
    echo "Install with: apt install bubblewrap  OR  dnf install bubblewrap" >&2
    exit 1
fi

# Check for claude and get its actual path
claude_path=$(command -v claude)
if [[ -z "$claude_path" ]]; then
    echo "Error: claude is not installed or not in PATH" >&2
    echo "Install from: https://docs.anthropic.com/en/docs/claude-code" >&2
    exit 1
fi
# Resolve symlinks to get the real path
claude_real_path=$(readlink -f "$claude_path")

# Commands that must run outside the sandbox (need write access to system paths)
if [[ "${1:-}" =~ ^(update|install|install-github-app)$ ]]; then
    exec claude "$@"
fi

# fix-apparmor: install AppArmor profile to allow bwrap user namespaces (Ubuntu 24.04+)
if [[ "${1:-}" == "fix-apparmor" ]]; then
    if ! command -v apparmor_parser &>/dev/null || [[ ! -d /sys/module/apparmor ]]; then
        echo "AppArmor is not active on this system. No fix needed." >&2
        exit 0
    fi
    if [[ -f /etc/apparmor.d/bwrap ]]; then
        echo "AppArmor bwrap profile already exists at /etc/apparmor.d/bwrap" >&2
        exit 0
    fi
    if [[ ! -f /proc/sys/kernel/apparmor_restrict_unprivileged_userns ]] || \
       [[ "$(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns)" != "1" ]]; then
        echo "Unprivileged user namespaces are not restricted. No fix needed." >&2
        exit 0
    fi
    echo "Installing AppArmor profile for bwrap..."
    if sudo tee /etc/apparmor.d/bwrap > /dev/null <<'APPARMOR'
abi <abi/4.0>,
include <tunables/global>

profile bwrap /usr/bin/bwrap flags=(unconfined) {
  userns,

  include if exists <local/bwrap>
}
APPARMOR
    then
        if sudo apparmor_parser -r /etc/apparmor.d/bwrap; then
            echo "AppArmor bwrap profile installed and loaded successfully."
        else
            echo "Error: Failed to load AppArmor bwrap profile." >&2
            exit 1
        fi
    else
        echo "Error: Failed to write AppArmor bwrap profile (sudo required)." >&2
        exit 1
    fi
    exit 0
fi

current_dir=$(pwd)
dir_name=$(basename "$current_dir")
# Sanitize directory name (colons can cause issues in some contexts)
safe_dir_name="${dir_name//:/-}"

env_args=()
mount_args=()
command_args=()
tmp_mode=false
no_network=false
git_mode=false
ssh_mode=false
aws_mode=false
keyring_mode=false
keep_env_mode=false
debug=false
dry_run=false
exec_mode=false
chic_mode=false
clear_tmp_mode=false

# Auto-detect WSL (check both osrelease and /proc/version for robustness)
# Cache result in /tmp to avoid repeated proc checks within a session
wsl_cache="/tmp/blaude-wsl-${UID:-$(id -u)}"
if [[ -f "$wsl_cache" ]]; then
    wsl_mode=$(cat "$wsl_cache")
else
    wsl_mode=false
    if grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null || \
       grep -qi microsoft /proc/version 2>/dev/null; then
        wsl_mode=true
    fi
    echo "$wsl_mode" > "$wsl_cache" 2>/dev/null || true
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        --env)
            env_args+=("$2")
            shift 2
            ;;
        -m|--mount)
            mount_args+=("$2")
            shift 2
            ;;
        --no-network)
            no_network=true
            shift
            ;;
        --git)
            git_mode=true
            shift
            ;;
        --ssh)
            ssh_mode=true
            shift
            ;;
        --aws)
            aws_mode=true
            shift
            ;;
        --keyring)
            keyring_mode=true
            shift
            ;;
        --keep-env)
            keep_env_mode=true
            shift
            ;;
        --tmp)
            tmp_mode=true
            shift
            ;;
        --clear-tmp)
            clear_tmp_mode=true
            shift
            ;;
        --debug)
            debug=true
            shift
            ;;
        --dry-run)
            dry_run=true
            debug=true
            shift
            ;;
        --exec)
            exec_mode=true
            shift
            command_args=("$@")
            break
            ;;
        --chic)
            chic_mode=true
            shift
            ;;
        *)
            # Accumulate ALL unknown args for claude (fixes ordering)
            command_args+=("$1")
            shift
            ;;
    esac
done

# Post-parsing bypass: catch install/update commands after blaude flags
# (e.g., "./blaude --debug install" where $1 was --debug, not install)
if [[ ${#command_args[@]} -gt 0 && "${command_args[0]}" =~ ^(update|install|install-github-app)$ ]]; then
    exec claude "${command_args[@]}"
fi

# --- Ensure Claude config has required flags ---

# Respect CLAUDE_CONFIG_DIR if set, otherwise use default
config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
required_flags='{"hasCompletedOnboarding": true, "bypassPermissionsModeAccepted": true}'

# Helper function to merge required flags into a config file
merge_config_flags() {
    local file="$1"
    local dir=$(dirname "$file")
    mkdir -p "$dir"
    if [[ -f "$file" ]]; then
        if command -v jq &>/dev/null; then
            jq -s '.[0] * .[1]' "$file" <(echo "$required_flags") > "${file}.tmp" && mv "${file}.tmp" "$file"
        fi
    else
        echo "$required_flags" > "$file"
    fi
}

# Update both config locations (Claude Code may read from either)
merge_config_flags "$config_dir/.claude.json"
merge_config_flags "$HOME/.claude.json"

# --- Build bwrap command ---

bwrap_args=(
    # Lifecycle & security
    --cap-drop ALL
    --die-with-parent
    # Note: --new-session removed to allow proper signal propagation for MCP servers
    # and background tasks. PID namespace provides equivalent process isolation.
    # Namespace isolation
    --unshare-pid --unshare-ipc --unshare-uts
    --hostname blaude
)

# User namespace: run as non-root inside sandbox (required for --dangerously-skip-permissions)
# This maps the current user to UID 1000 inside the sandbox
if [[ $(id -u) -eq 0 ]]; then
    # Running as root: create user namespace and become non-root inside
    bwrap_args+=(--unshare-user --uid 1000 --gid 1000)
else
    # Non-root: still use user namespace for isolation, keep same UID
    bwrap_args+=(--unshare-user --uid "$(id -u)" --gid "$(id -g)")
fi

# System mounts (read-only)
bwrap_args+=(--ro-bind /usr /usr)
[[ -d /lib ]] && bwrap_args+=(--ro-bind /lib /lib)
[[ -d /lib64 ]] && bwrap_args+=(--ro-bind /lib64 /lib64)
[[ -d /lib32 ]] && bwrap_args+=(--ro-bind /lib32 /lib32)
bwrap_args+=(--ro-bind /bin /bin)
[[ -d /sbin ]] && bwrap_args+=(--ro-bind /sbin /sbin)
# Mount /etc read-only, but handle resolv.conf symlink specially for WSL2/systemd
# bwrap's --file and bind mounts follow symlinks, so if /etc/resolv.conf is a symlink
# to e.g. /run/systemd/resolve/stub-resolv.conf, we need to create that target path
# See: https://github.com/containers/bubblewrap/issues/390
# Note: The actual symlink target mount is added AFTER base args (--tmpfs /run) below
resolv_symlink_target=""
resolv_symlink_dir=""
resolv_tmp=""
if [[ -L /etc/resolv.conf ]]; then
    resolv_target=$(readlink /etc/resolv.conf)
    resolv_content=$(cat /etc/resolv.conf 2>/dev/null)
    if [[ -n "$resolv_content" && "$resolv_target" == /* ]]; then
        # Absolute symlink - save info for later (after --tmpfs /run is added)
        resolv_tmp=$(mktemp)
        echo "$resolv_content" > "$resolv_tmp"
        resolv_symlink_target="$resolv_target"
        resolv_symlink_dir=$(dirname "$resolv_target")
        trap "rm -f '$resolv_tmp'" EXIT
    elif [[ -n "$resolv_content" ]]; then
        # Relative symlink - try direct bind mount over the symlink
        resolv_tmp=$(mktemp)
        echo "$resolv_content" > "$resolv_tmp"
        trap "rm -f '$resolv_tmp'" EXIT
    fi
fi
bwrap_args+=(--ro-bind /etc /etc)
# /usr/share is already included via /usr, but ensure it's accessible for tools needing
# terminfo, locales, ca-certificates, etc.

# Writable overlay for pyenv shims (pyenv init tries to write here)
if [[ -d /usr/share/pyenv/shims ]]; then
    bwrap_args+=(--tmpfs /usr/share/pyenv/shims)
fi

# Determine sandbox UID for paths
if [[ $(id -u) -eq 0 ]]; then
    sandbox_uid=1000
else
    sandbox_uid=$(id -u)
fi

# Required filesystems
bwrap_args+=(
    --dev /dev
    --proc /proc
)
# /tmp: bind host's /tmp by default, use tmpfs with --clear-tmp
if [[ "$clear_tmp_mode" == true ]]; then
    bwrap_args+=(--tmpfs /tmp)
else
    bwrap_args+=(--bind /tmp /tmp)
fi
bwrap_args+=(
    --tmpfs /var
    --tmpfs /run
    --dir "/run/user/$sandbox_uid"
)

# D-Bus session bus access (optional, for keytar/GNOME Keyring/Secret Service)
# Disabled by default - MCP servers fall back to file-based token storage
# Enable with --keyring flag if you have GNOME Keyring properly configured
if [[ "$keyring_mode" == true ]]; then
    dbus_socket=""
    if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
        if [[ "$DBUS_SESSION_BUS_ADDRESS" == *"unix:path="* ]]; then
            dbus_socket="${DBUS_SESSION_BUS_ADDRESS#*unix:path=}"
            dbus_socket="${dbus_socket%%,*}"
        elif [[ "$DBUS_SESSION_BUS_ADDRESS" == *"unix:abstract="* ]]; then
            [[ $debug -eq 1 ]] && echo "Warning: D-Bus uses abstract socket (won't work in sandbox)" >&2
        fi
    fi
    [[ -z "$dbus_socket" ]] && dbus_socket="/run/user/$(id -u)/bus"

    if [[ -S "$dbus_socket" ]]; then
        bwrap_args+=(--bind "$dbus_socket" "$dbus_socket")
        [[ $debug -eq 1 ]] && echo "Binding D-Bus session socket: $dbus_socket" >&2
    fi
fi

# Complete resolv.conf symlink handling (deferred from above, after --tmpfs /run)
if [[ -n "$resolv_symlink_target" ]]; then
    # Create the symlink target directory and mount our content there
    bwrap_args+=(--dir "$resolv_symlink_dir")
    bwrap_args+=(--ro-bind "$resolv_tmp" "$resolv_symlink_target")
elif [[ -n "$resolv_tmp" ]]; then
    # Relative symlink case - bind mount over /etc/resolv.conf
    bwrap_args+=(--ro-bind "$resolv_tmp" /etc/resolv.conf)
fi

# Handle custom temp directory if CLAUDE_CODE_TMPDIR is set
# Claude appends /claude/ to this path for its temp files
if [[ -n "${CLAUDE_CODE_TMPDIR:-}" && "$CLAUDE_CODE_TMPDIR" != "/tmp" ]]; then
    # Ensure the custom tmpdir is writable inside the sandbox
    bwrap_args+=(--tmpfs "$CLAUDE_CODE_TMPDIR")
fi

# Minimal home exposure (only what claude needs)
# Create home directory structure with writable areas for package managers
bwrap_args+=(--tmpfs "$HOME")
bwrap_args+=(--dir "$HOME/.local")
bwrap_args+=(--dir "$HOME/.local/bin")
bwrap_args+=(--dir "$HOME/.local/share")
bwrap_args+=(--dir "$HOME/.local/lib")

# Writable directories for package managers (ephemeral - cleared on exit)
# ~/.cache is writable for build caches
# ~/go, ~/.cargo for language-specific package managers
bwrap_args+=(
    --dir "$HOME/.cache"
    --dir "$HOME/go"
    --dir "$HOME/go/bin"
    --dir "$HOME/go/pkg"
    --dir "$HOME/.cargo"
    --dir "$HOME/.cargo/bin"
    --dir "$HOME/.cargo/registry"
)

# GNOME Keyring storage (optional, only with --keyring flag)
if [[ "$keyring_mode" == true ]]; then
    keyrings_dir="$HOME/.local/share/keyrings"
    if [[ -d "$keyrings_dir" ]]; then
        [[ $debug -eq 1 ]] && echo "Binding GNOME Keyring storage: $keyrings_dir" >&2
        bwrap_args+=(--bind "$keyrings_dir" "$keyrings_dir")
    else
        mkdir -p "$keyrings_dir" 2>/dev/null
        [[ -d "$keyrings_dir" ]] && bwrap_args+=(--bind "$keyrings_dir" "$keyrings_dir")
    fi
fi

# npm cache: bind host's cache if exists (for npx-based MCP servers), else create empty
if [[ -d "$HOME/.npm" ]]; then
    bwrap_args+=(--bind "$HOME/.npm" "$HOME/.npm")
else
    bwrap_args+=(--dir "$HOME/.npm" --dir "$HOME/.npm/_cacache")
fi

# Bind host's user binaries and their backing virtual environments
# Many tools in ~/.local/bin are symlinks to pipx/uv venvs
bwrap_args+=(--dir /opt)

if [[ -d "$HOME/.local/bin" ]]; then
    bwrap_args+=(--dir /opt/host-bin)
    bwrap_args+=(--ro-bind "$HOME/.local/bin" /opt/host-bin)
fi

# Bind claude binary to its expected location (Claude Code checks for itself there)
if [[ -e "$HOME/.local/bin/claude" ]]; then
    bwrap_args+=(--ro-bind "$HOME/.local/bin/claude" "$HOME/.local/bin/claude")
fi

# Bind pipx virtual environments (symlink targets for pipx-installed tools)
if [[ -d "$HOME/.local/share/pipx" ]]; then
    bwrap_args+=(--ro-bind "$HOME/.local/share/pipx" "$HOME/.local/share/pipx")
fi

# Bind uv tools directory (for uv-installed MCP servers like notebooklm-mcp)
# These are symlink targets for tools in ~/.local/bin installed via `uv tool install`
if [[ -d "$HOME/.local/share/uv/tools" ]]; then
    bwrap_args+=(--ro-bind "$HOME/.local/share/uv/tools" "$HOME/.local/share/uv/tools")
fi

# Bind uv-managed Python installations (some uv tools use these instead of system Python)
if [[ -d "$HOME/.local/share/uv/python" ]]; then
    bwrap_args+=(--ro-bind "$HOME/.local/share/uv/python" "$HOME/.local/share/uv/python")
fi

# uv cache: bind if exists for faster tool installs, else leave ephemeral
if [[ -d "$HOME/.cache/uv" ]]; then
    bwrap_args+=(--bind "$HOME/.cache/uv" "$HOME/.cache/uv")
fi

# Bind NVM (Node Version Manager) for npx-based MCP servers
# NVM installs Node.js to ~/.nvm/versions/node/<version>/
if [[ -d "$HOME/.nvm" ]]; then
    bwrap_args+=(--ro-bind "$HOME/.nvm" "$HOME/.nvm")
    nvm_installed=true

    # Auto-detect npm-linked packages and mount their source directories
    # npm link creates symlinks in node_modules that point outside ~/.nvm
    declare -A npm_link_targets  # Use associative array to dedupe
    while IFS= read -r -d '' symlink; do
        target=$(readlink -f "$symlink" 2>/dev/null)
        # Only mount if target exists and is outside ~/.nvm
        if [[ -n "$target" && -e "$target" && "$target" != "$HOME/.nvm"* ]]; then
            # Get the top-level directory of the linked package
            # e.g., /home/user/my-project/dist/index.js -> /home/user/my-project
            link_dir="$target"
            while [[ "$link_dir" != "/" && "$link_dir" != "$HOME" && ! -f "$link_dir/package.json" ]]; do
                link_dir=$(dirname "$link_dir")
            done
            # Safety: never mount $HOME itself, only subdirectories
            [[ -f "$link_dir/package.json" && "$link_dir" != "$HOME" ]] && npm_link_targets["$link_dir"]=1
        fi
    done < <(find "$HOME/.nvm/versions" -type l -path "*/node_modules/*" -print0 2>/dev/null)

    for link_target in "${!npm_link_targets[@]}"; do
        [[ $debug -eq 1 ]] && echo "Auto-mounting npm-linked package: $link_target" >&2
        bwrap_args+=(--ro-bind "$link_target" "$link_target")

        # MCP server token files (e.g., ms-365-mcp stores tokens at package root)
        # Mount these read-write over the read-only package mount for persistence
        for token_file in ".token-cache.json" ".selected-account.json"; do
            token_path="$link_target/$token_file"
            # Create the file if it doesn't exist (needed for bind mount)
            [[ ! -f "$token_path" ]] && touch "$token_path" 2>/dev/null
            if [[ -f "$token_path" ]]; then
                [[ $debug -eq 1 ]] && echo "  Mounting token file read-write: $token_path" >&2
                bwrap_args+=(--bind "$token_path" "$token_path")
            fi
        done
    done
else
    nvm_installed=false
fi

# Bind host's cargo bin if it exists
if [[ -d "$HOME/.cargo/bin" ]]; then
    bwrap_args+=(--dir /opt/host-cargo-bin)
    bwrap_args+=(--ro-bind "$HOME/.cargo/bin" /opt/host-cargo-bin)
fi

# Bind host's go bin if it exists
if [[ -d "$HOME/go/bin" ]]; then
    bwrap_args+=(--dir /opt/host-go-bin)
    bwrap_args+=(--ro-bind "$HOME/go/bin" /opt/host-go-bin)
fi

# Bind claude's data directory if it exists
# Mounted read-write so the autoupdater can write to versions/ if it runs despite
# DISABLE_AUTOUPDATER=1 (prevents EROFS errors on copyfile to versions/*.tmp.*)
if [[ -d "$HOME/.local/share/claude" ]]; then
    bwrap_args+=(--bind "$HOME/.local/share/claude" "$HOME/.local/share/claude")
fi

# Ensure config directory exists on host and create mount point inside sandbox
mkdir -p "$config_dir"
bwrap_args+=(--dir "$config_dir")
bwrap_args+=(--bind "$config_dir" "$config_dir")

# Mount ~/.claude.json (OAuth session, MCP servers, preferences, caches)
if [[ -f "$HOME/.claude.json" ]]; then
    bwrap_args+=(--bind "$HOME/.claude.json" "$HOME/.claude.json")
fi

# claudechic config file (~/.claude/.claudechic.yaml) is already accessible
# via the config_dir mount above - no separate mount needed.
# Note: Do NOT bind-mount the specific file, as claudechic uses atomic writes
# (os.replace) which fail on bind-mounted files.

# claudechic debug log (only needed if CLAUDECHIC_DEBUG is set)
if [[ -n "${CLAUDECHIC_DEBUG:-}" ]]; then
    claudechic_log="$HOME/claudechic.log"
    touch "$claudechic_log" 2>/dev/null
    [[ -f "$claudechic_log" ]] && bwrap_args+=(--bind "$claudechic_log" "$claudechic_log")
fi

# notebooklm-mcp auth directories (token cache, Chrome profiles, config)
for notebooklm_dir in "$HOME/.notebooklm-mcp" "$HOME/.notebooklm-mcp-cli"; do
    if [[ -d "$notebooklm_dir" ]]; then
        bwrap_args+=(--bind "$notebooklm_dir" "$notebooklm_dir")
    else
        mkdir -p "$notebooklm_dir" 2>/dev/null
        [[ -d "$notebooklm_dir" ]] && bwrap_args+=(--bind "$notebooklm_dir" "$notebooklm_dir")
    fi
done

# User config directory (~/.config/)
# Includes uv config (python-preference), fabric, google-chrome, and other tool configs
if [[ -d "$HOME/.config" ]]; then
    bwrap_args+=(--bind "$HOME/.config" "$HOME/.config")
fi

# arxiv-storage directory (for research paper management tools)
if [[ -d "$HOME/arxiv-storage" ]]; then
    bwrap_args+=(--bind "$HOME/arxiv-storage" "$HOME/arxiv-storage")
fi

# Claude memory directory (for persistent memory across sessions)
if [[ -d "$HOME/.claude-mem" ]]; then
    bwrap_args+=(--bind "$HOME/.claude-mem" "$HOME/.claude-mem")
fi

# Bun runtime and package manager
if [[ -d "$HOME/.bun" ]]; then
    bwrap_args+=(--ro-bind "$HOME/.bun" "$HOME/.bun")
fi

# Network isolation
if [[ "$no_network" == true ]]; then
    bwrap_args+=(--unshare-net)
fi

# Git mode: mount git configuration files and pass GitHub tokens
if [[ "$git_mode" == true ]]; then
    if [[ -f "$HOME/.gitconfig" ]]; then
        bwrap_args+=(--ro-bind "$HOME/.gitconfig" "$HOME/.gitconfig")
    fi
    if [[ -f "$HOME/.git-credentials" ]]; then
        bwrap_args+=(--ro-bind "$HOME/.git-credentials" "$HOME/.git-credentials")
    fi
    # GitHub tokens (for gh CLI, git push/pull, MCP servers)
    for var in GH_TOKEN GITHUB_TOKEN; do
        if [[ -n "${!var:-}" ]]; then
            bwrap_args+=(--setenv "$var" "${!var}")
        fi
    done
fi

# SSH mode: mount SSH keys and forward SSH agent
if [[ "$ssh_mode" == true ]]; then
    if [[ -d "$HOME/.ssh" ]]; then
        bwrap_args+=(--ro-bind "$HOME/.ssh" "$HOME/.ssh")
    fi
    if [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]]; then
        bwrap_args+=(--bind "$SSH_AUTH_SOCK" "$SSH_AUTH_SOCK")
    fi
fi

# AWS mode: mount AWS config/credentials for Bedrock authentication
if [[ "$aws_mode" == true ]]; then
    if [[ -d "$HOME/.aws" ]]; then
        bwrap_args+=(--ro-bind "$HOME/.aws" "$HOME/.aws")
    fi
    # Mount GOOGLE_APPLICATION_CREDENTIALS file if set and exists
    if [[ -n "${GOOGLE_APPLICATION_CREDENTIALS:-}" && -f "$GOOGLE_APPLICATION_CREDENTIALS" ]]; then
        bwrap_args+=(--ro-bind "$GOOGLE_APPLICATION_CREDENTIALS" "$GOOGLE_APPLICATION_CREDENTIALS")
    fi
fi

# CLAUDE_ENV_FILE: mount the env file if set and exists
if [[ -n "${CLAUDE_ENV_FILE:-}" && -f "$CLAUDE_ENV_FILE" ]]; then
    bwrap_args+=(--ro-bind "$CLAUDE_ENV_FILE" "$CLAUDE_ENV_FILE")
fi

# CLAUDE_CODE_PLUGIN_SEED_DIR: mount the plugin seed directory if set and exists
if [[ -n "${CLAUDE_CODE_PLUGIN_SEED_DIR:-}" && -d "$CLAUDE_CODE_PLUGIN_SEED_DIR" ]]; then
    bwrap_args+=(--ro-bind "$CLAUDE_CODE_PLUGIN_SEED_DIR" "$CLAUDE_CODE_PLUGIN_SEED_DIR")
fi

# Additional mount points
for mount_spec in "${mount_args[@]}"; do
    # Check for :rw suffix (read-write mode)
    if [[ "$mount_spec" == *":rw" ]]; then
        mount_mode="bind"
        mount_spec="${mount_spec%:rw}"  # Strip :rw suffix
    else
        mount_mode="ro-bind"
    fi

    # Expand ~ to $HOME
    host_path="${mount_spec/#\~/$HOME}"

    if [[ ! -e "$host_path" ]]; then
        echo "Error: Mount path does not exist: $host_path" >&2
        exit 1
    fi

    bwrap_args+=(--$mount_mode "$host_path" "$host_path")
done

# Workspace mount
if [[ "$tmp_mode" == true ]]; then
    bwrap_args+=(--chdir /tmp)
else
    bwrap_args+=(--bind "$current_dir" "/workspaces/$safe_dir_name")
    bwrap_args+=(--chdir "/workspaces/$safe_dir_name")
fi

# Environment handling
if [[ "$keep_env_mode" != true ]]; then
    # Clean environment with selective passthrough (default)
    bwrap_args+=(--clearenv)
    bwrap_args+=(--setenv HOME "$HOME")
    bwrap_args+=(--setenv USER "${USER:-$(whoami)}")
    bwrap_args+=(--setenv TERM "${TERM:-xterm-256color}")
    [[ -n "${COLORTERM:-}" ]] && bwrap_args+=(--setenv COLORTERM "$COLORTERM")
fi
# PATH includes:
# 1. Ephemeral package directories (writable, for new installs)
# 2. Host user binaries at /opt/host-* (read-only, for uv, node, etc.)
# 3. NVM node binaries if available
# 4. System directories
sandbox_path="$HOME/.local/bin:$HOME/go/bin:$HOME/.cargo/bin:$HOME/.bun/bin:/opt/host-bin:/opt/host-cargo-bin:/opt/host-go-bin"
# Add NVM bin directory if NVM is installed (for npx, node, npm)
if [[ -n "${NVM_BIN:-}" ]]; then
    sandbox_path="$sandbox_path:$NVM_BIN"
elif [[ "$nvm_installed" == true ]]; then
    # Try to find the current/default node version
    nvm_node_bin=""
    if [[ -f "$HOME/.nvm/alias/default" ]]; then
        # Read default version from alias file (contains version string like "v22.21.1")
        nvm_version=$(< "$HOME/.nvm/alias/default")
        # Handle lts/* aliases (e.g., "lts/iron" -> read actual version from lts alias)
        if [[ "$nvm_version" == lts/* ]]; then
            lts_name="${nvm_version#lts/}"
            [[ -f "$HOME/.nvm/alias/lts/$lts_name" ]] && nvm_version=$(< "$HOME/.nvm/alias/lts/$lts_name")
        fi
        [[ -d "$HOME/.nvm/versions/node/$nvm_version/bin" ]] && nvm_node_bin="$HOME/.nvm/versions/node/$nvm_version/bin"
    fi
    # Fall back to most recently modified node version
    if [[ -z "$nvm_node_bin" && -d "$HOME/.nvm/versions/node" ]]; then
        nvm_node_bin=$(ls -td "$HOME/.nvm/versions/node"/*/bin 2>/dev/null | head -1)
    fi
    [[ -n "$nvm_node_bin" ]] && sandbox_path="$sandbox_path:$nvm_node_bin"
fi
sandbox_path="$sandbox_path:/usr/local/bin:/usr/bin:/bin:/sbin:/usr/sbin"
bwrap_args+=(--setenv PATH "$sandbox_path")
# Package manager environment variables
bwrap_args+=(--setenv GOPATH "$HOME/go")
bwrap_args+=(--setenv CARGO_HOME "$HOME/.cargo")
