#!/bin/bash
# blaude - Run Claude Code in a bubblewrap sandbox.
# Options not listed in README.md are passed through to claude.

# Check for bwrap (capture path for later reuse — overlay-support mtime check needs it)
_bwrap_bin=$(command -v bwrap)
if [[ -z "$_bwrap_bin" ]]; then
    echo "Error: bubblewrap (bwrap) is not installed" >&2
    echo "Install with: apt install bubblewrap  OR  dnf install bubblewrap" >&2
    exit 1
fi

# Check for claude
if ! command -v claude &>/dev/null; then
    echo "Error: claude is not installed or not in PATH" >&2
    echo "Install from: https://docs.anthropic.com/en/docs/claude-code" >&2
    exit 1
fi
# Commands that must run outside the sandbox (need write access to system paths).
# One regex, tested both as $1 here and post-flag-parse below (e.g. `--debug install`).
# DISABLE_UPDATES (Claude Code 2.1.118+) is enforced by claude itself via the
# inherited host env — no host-side guard needed; claude prints its own message.
_bypass_cmds_re='^(update|install|install-github-app)$'
if [[ "${1:-}" =~ $_bypass_cmds_re ]]; then
    exec claude "$@"
fi

# AppArmor detection (shared by fix-apparmor subcommand and startup warning)
_apparmor_present() {
    [[ -d /sys/module/apparmor ]] && command -v apparmor_parser &>/dev/null
}
_apparmor_restricts_userns() {
    [[ -f /proc/sys/kernel/apparmor_restrict_unprivileged_userns ]] || return 1
    [[ "$(< /proc/sys/kernel/apparmor_restrict_unprivileged_userns)" == "1" ]]
}

# fix-apparmor: install AppArmor profile to allow bwrap user namespaces (Ubuntu 24.04+)
if [[ "${1:-}" == "fix-apparmor" ]]; then
    if ! _apparmor_present; then
        echo "AppArmor is not active on this system. No fix needed." >&2
        exit 0
    fi
    if [[ -f /etc/apparmor.d/bwrap ]]; then
        echo "AppArmor bwrap profile already exists at /etc/apparmor.d/bwrap" >&2
        exit 0
    fi
    if ! _apparmor_restricts_userns; then
        echo "Unprivileged user namespaces are not restricted. No fix needed." >&2
        exit 0
    fi
    echo "Installing AppArmor profile for bwrap..."
    if sudo tee /etc/apparmor.d/bwrap > /dev/null <<'APPARMOR'
abi <abi/4.0>,
include <tunables/global>

profile bwrap /usr/bin/bwrap flags=(unconfined) {
  userns,

  include if exists <local/bwrap>
}
APPARMOR
    then
        if sudo apparmor_parser -r /etc/apparmor.d/bwrap; then
            echo "AppArmor bwrap profile installed and loaded successfully."
        else
            echo "Error: Failed to load AppArmor bwrap profile." >&2
            exit 1
        fi
    else
        echo "Error: Failed to write AppArmor bwrap profile (sudo required)." >&2
        exit 1
    fi
    exit 0
fi

current_dir=$PWD
dir_name="${current_dir##*/}"
_host_uid=$EUID
_host_gid=${GROUPS[0]}
# Sanitize directory name (colons can cause issues in bwrap mount paths)
safe_dir_name="${dir_name//:/-}"

# Sandbox UID: root is remapped to 1000 (required for --dangerously-skip-permissions)
if [[ $_host_uid -eq 0 ]]; then
    sandbox_uid=1000
    sandbox_gid=1000
else
    sandbox_uid=$_host_uid
    sandbox_gid=$_host_gid
fi

# Host-side cache directory for blaude's own state (boolean probes, package-mount
# scans). Placed under $HOME/.cache, which the sandbox shadows with a tmpfs (see
# "--tmpfs $HOME" below) and never binds back — so a contained agent cannot poison
# cache files that a later blaude run reads and trusts. (Earlier versions used
# /tmp, which IS bind-mounted read-write into the sandbox by default.)
_cache_dir="$HOME/.cache/blaude"
mkdir -p "$_cache_dir" 2>/dev/null && chmod 700 "$_cache_dir" 2>/dev/null

env_args=()
mount_args=()
command_args=()
tmp_mode=false
no_network=false
remote_control_mode=false
rc_subcommand=false
git_mode=false
ssh_mode=false
aws_mode=false
keyring_mode=false
keep_env_mode=false
allow_protected_writes=false
debug=false
dry_run=false
exec_mode=false
chic_mode=false
clear_tmp_mode=false
no_clipboard=false

# Cache a boolean result at $_cache_dir/<key>-$UID to avoid repeated
# proc/help checks. Compute fn must set _CACHED_BOOL_RESULT.
# Result is returned via the global _CACHED_BOOL_RESULT — assigning instead of
# printing avoids the $(...) fork on every cache hit.
# Optional 3rd arg: invalidate cache when that path is newer (stat via bash -nt,
# no fork) — used by callers whose answer can change when a binary is upgraded.
# A compute fn that could not actually determine the answer sets
# _CACHED_BOOL_NOCACHE=true; its guess is then used for this run only, never
# persisted. Without that, one failed probe would freeze a wrong answer in place
# until the invalidate_path's mtime happened to change.
_CACHED_BOOL_RESULT=""
_CACHED_BOOL_NOCACHE=false
_cached_bool() {
    local key="$1" compute_fn="$2" invalidate_path="${3:-}"
    local cache="${_cache_dir}/${key}-${_host_uid}"
    if [[ -f "$cache" ]] && \
       { [[ -z "$invalidate_path" ]] || [[ ! "$invalidate_path" -nt "$cache" ]]; }; then
        IFS= read -r _CACHED_BOOL_RESULT < "$cache"
        return
    fi
    _CACHED_BOOL_NOCACHE=false
    "$compute_fn"
    [[ "$_CACHED_BOOL_NOCACHE" == true ]] && return
    printf '%s\n' "$_CACHED_BOOL_RESULT" > "$cache" 2>/dev/null || true
}

# ${var,,} lowercases — matches `grep -i` semantics without shopt manipulation.
_detect_wsl() {
    local osrelease="" version=""
    [[ -r /proc/sys/kernel/osrelease ]] && IFS= read -r osrelease < /proc/sys/kernel/osrelease
    [[ -r /proc/version ]] && IFS= read -r version < /proc/version
    if [[ "${osrelease,,}" == *microsoft* || "${version,,}" == *microsoft* ]]; then
        _CACHED_BOOL_RESULT=true
    else
        _CACHED_BOOL_RESULT=false
    fi
}
_cached_bool wsl _detect_wsl
wsl_mode=$_CACHED_BOOL_RESULT

# Overlay support was added in bwrap 0.8.0. Probed once here — ahead of every
# mount decision — because both the protected-paths section and the host-state
# mounts below (~/.config, npm/uv/bun caches) choose their strategy from it.
# _cached_bool's mtime invalidation is keyed on the bwrap binary, so an upgrade
# takes effect immediately without forking `bwrap --help` on every launch;
# probe $_bwrap_bin rather than a bare `bwrap` so the two agree on which binary.
#
# Distinguish "bwrap answered, and the flag isn't there" from "bwrap didn't
# answer". Only the first is a fact about this host worth persisting: a real
# 0.7.x stays 0.7.x until upgraded, and an upgrade bumps the mtime that
# invalidates the cache. A failed probe — bwrap blocked by an outer sandbox,
# killed, or silent for any other reason — is a transient accident, and caching
# its "false" would silently downgrade ~/.config and the caches to plain
# read-write binds on every later launch, with nothing to invalidate it. So the
# guess is used for this run and deliberately not written to disk.
_overlay_probe_failed=false
_detect_overlay() {
    local help status
    help=$("$_bwrap_bin" --help 2>&1)
    status=$?
    if (( status != 0 )) || [[ -z "$help" ]]; then
        _overlay_probe_failed=true
        _CACHED_BOOL_RESULT=false
        _CACHED_BOOL_NOCACHE=true
        return
    fi
    [[ "$help" == *--tmp-overlay* ]] && _CACHED_BOOL_RESULT=true || _CACHED_BOOL_RESULT=false
}
_cached_bool overlay _detect_overlay "$_bwrap_bin"
overlay_supported=$_CACHED_BOOL_RESULT
# Paths that had to stay host-writable because overlays are unavailable. Listed
# in one warning just above the --debug/--dry-run command dump near the bottom.
_overlay_fallback_paths=()

# Find asciinema's PID by walking ancestor processes via /proc.
_find_asciinema_pid() {
    local pid ppid key val comm _
    pid=$$
    while [[ $pid -gt 1 ]]; do
        ppid=
        while IFS=$':\t ' read -r key val _; do
            [[ "$key" == "PPid" ]] && ppid=$val && break
        done < /proc/$pid/status 2>/dev/null
        [[ -z "$ppid" || "$ppid" == "0" ]] && return 1
        # No $(< file 2>/dev/null): the redirect breaks the bash file-read
        # optimization and always yields "" (same gotcha as the settings scan
        # below). 2>/dev/null before < so a vanished process stays quiet.
        comm=""
        IFS= read -r comm 2>/dev/null < "/proc/$ppid/comm"
        if [[ "$comm" == "asciinema" ]]; then
            echo "$ppid"
            return 0
        fi
        pid=$ppid
    done
    return 1
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --env|-m|--mount)
            # Guard before `shift 2`: with the flag as the final argument bash
            # shifts nothing and returns 1, so $1 would stay put and the loop
            # would spin forever.
            [[ $# -ge 2 ]] || { echo "Error: $1 requires a value" >&2; exit 1; }
            if [[ "$1" == --env ]]; then env_args+=("$2"); else mount_args+=("$2"); fi
            shift 2
            ;;
        --no-network)
            no_network=true
            shift
            ;;
        --git)
            git_mode=true
            shift
            ;;
        --ssh)
            ssh_mode=true
            shift
            ;;
        --remote-control)
            # Consumed (not forwarded): prepare the env so /remote-control works
            # on demand while claude still starts with --dangerously-skip-permissions.
            remote_control_mode=true
            shift
            ;;
        --aws)
            aws_mode=true
            shift
            ;;
        --keyring)
            keyring_mode=true
            shift
            ;;
        --keep-env)
            keep_env_mode=true
            shift
            ;;
        --allow-protected-writes)
            allow_protected_writes=true
            shift
            ;;
        --tmp)
            tmp_mode=true
            shift
            ;;
        --clear-tmp)
            clear_tmp_mode=true
            shift
            ;;
        --debug)
            debug=true
            shift
            ;;
        --dry-run)
            dry_run=true
            debug=true
            shift
            ;;
        --exec)
            exec_mode=true
            shift
            command_args=("$@")
            break
            ;;
        --chic)
            chic_mode=true
            shift
            ;;
        --no-clipboard)
            no_clipboard=true
            shift
            ;;
        *)
            command_args+=("$1")
            shift
            ;;
    esac
done

# Post-parsing bypass: catch install/update commands after blaude flags
# (e.g., "./blaude --debug install" where $1 was --debug, not install)
if [[ ${#command_args[@]} -gt 0 && "${command_args[0]}" =~ $_bypass_cmds_re ]]; then
    exec claude "${command_args[@]}"
fi

# Remote Control mode: `claude remote-control` (server mode) passes through as a
# subcommand; the --remote-control flag was consumed above. All paths
# set the same env mode so the GrowthBook feature-flag eligibility check can run
# (see the hardcoded env-var section below). Match the bare subcommand only in
# position 0 to avoid false positives like `-p "remote-control"`. rc_subcommand
# additionally selects the verbatim no-skip-permissions branch in "Build command".
if [[ "${command_args[0]:-}" == "remote-control" ]]; then
    remote_control_mode=true
    rc_subcommand=true
fi

if [[ "$remote_control_mode" == true ]]; then
    echo "Note: Remote Control mode — enabling telemetry + GrowthBook feature-flag fetching for" >&2
    echo "  this session (required for Remote Control eligibility; off in normal sessions)." >&2
    if [[ -n "${ANTHROPIC_API_KEY:-}" || -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]]; then
        echo "  Note: ANTHROPIC_API_KEY / CLAUDE_CODE_OAUTH_TOKEN block Remote Control (needs claude.ai" >&2
        echo "  OAuth) — forcing them unset inside the sandbox; claude will use your /login session." >&2
    fi
    echo "Note: Remote Control requires approving actions (--dangerously-skip-permissions does not apply)." >&2
    [[ "$no_network" == true ]] && \
        echo "  Warning: --no-network is set; Remote Control needs outbound network and will fail." >&2
fi

# --- Ensure Claude config has required flags ---

config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
required_flags='{"hasCompletedOnboarding": true, "bypassPermissionsModeAccepted": true}'

have_jq=""  # lazy: probed on first merge_config_flags fallthrough

merge_config_flags() {
    local file="$1" dir="${1%/*}"
    [[ -d "$dir" ]] || mkdir -p "$dir"
    # This runs on the HOST, pre-sandbox, with the user's full privileges, but
    # $config_dir is bind-mounted read-write into the sandbox as a *directory* —
    # only $HOME/.claude.json is pinned as a file bind, so a contained agent can
    # unlink $config_dir/.claude.json and plant symlinks beside it. A shell
    # redirect follows those, turning this into an arbitrary host-file write
    # (~/.bashrc, ~/.config/systemd/user/*.service), so:
    #   - refuse a symlink at $file. `! -f` is *true* for a dangling one, so
    #     without this the `echo >` below would create the link's target.
    #   - never write the predictable "${file}.tmp": a pre-planted symlink there
    #     redirects jq's output, which embeds agent-controlled JSON verbatim.
    if [[ -L "$file" ]]; then
        echo "Warning: $file is a symlink — refusing to update it." >&2
        echo "  Replace it with a regular file to let blaude set the onboarding flags." >&2
        return
    fi
    if [[ ! -f "$file" ]]; then
        echo "$required_flags" > "$file"
        return
    fi
    # Cheap pre-check avoids forking jq (and two greps) on every launch when flags
    # are already set. Slurp the file once and regex-match both flags via bash;
    # false negatives (unusual JSON formatting) fall through to the jq path.
    local contents re1='"hasCompletedOnboarding"[[:space:]]*:[[:space:]]*true'
    local re2='"bypassPermissionsModeAccepted"[[:space:]]*:[[:space:]]*true'
    contents=$(< "$file")
    [[ "$contents" =~ $re1 && "$contents" =~ $re2 ]] && return
    [[ -z "$have_jq" ]] && { command -v jq &>/dev/null && have_jq=true || have_jq=false; }
    # Say so rather than returning quietly: on a machine without jq this is the
    # likeliest reason the flags never get set, and the only symptom otherwise is
    # claude re-prompting for onboarding every launch. Fires only when the flags
    # are actually missing — the regex pre-check above returns first once set.
    [[ "$have_jq" == true ]] || {
        echo "Warning: jq not installed — cannot set the onboarding flags in $file." >&2
        echo "  claude may prompt for onboarding; install jq or complete it once by hand." >&2
        return
    }
    jq -e '.hasCompletedOnboarding == true and .bypassPermissionsModeAccepted == true' "$file" >/dev/null 2>&1 && return
    local tmp
    tmp=$(mktemp "$dir/.claude.json.XXXXXX") || return
    # `.[0] | if type == "object"` repairs a file holding nothing, `null`, or a
    # non-object: -s wraps the input in an array, so an empty file yields [] and
    # .[0] is null, and `null * {...}` is a hard jq error. Without the guard the
    # merge fails, the flags are never written, and claude stops at the onboarding
    # prompt on every launch with no explanation. The sandbox can reach this file
    # ($config_dir is bind-mounted rw), so a truncated write must stay repairable.
    # mv renames rather than writing through, and $file is known not to be a symlink.
    if jq -s --argjson flags "$required_flags" \
         '(.[0] | if type == "object" then . else {} end) * $flags' "$file" > "$tmp" \
       && [[ -s "$tmp" ]]; then
        mv "$tmp" "$file"
    else
        echo "Warning: could not update $file (malformed JSON?)." >&2
        echo "  claude may prompt for onboarding until it is fixed or removed." >&2
    fi
    rm -f "$tmp"   # no-op after a successful rename
}

# Update both config locations (Claude Code may read from either).
# Guard the second call in case CLAUDE_CONFIG_DIR=$HOME — then both paths collapse
# to the same file and the second merge would be redundant.
merge_config_flags "$config_dir/.claude.json"
[[ "$config_dir/.claude.json" != "$HOME/.claude.json" ]] && \
    merge_config_flags "$HOME/.claude.json"

# Warn if any settings file disables bypass-permissions mode — blaude always
# passes --dangerously-skip-permissions, so this would silently downgrade to
# default mode. We can't override managed-settings.json (enterprise-controlled).
# No 2>/dev/null on $(< file): that breaks the bash file-read optimization and
# silently returns empty. Existence + readability check is sufficient.
_disable_re='"disableBypassPermissionsMode"[[:space:]]*:[[:space:]]*"disable"'
_settings_files=("$config_dir/settings.json" /etc/claude-code/managed-settings.json)
[[ "$config_dir/settings.json" != "$HOME/.claude/settings.json" ]] && \
    _settings_files+=("$HOME/.claude/settings.json")
# managed-settings.d/ drop-in directory (Claude Code 2.1.83+); fragments merge alphabetically.
if [[ -d /etc/claude-code/managed-settings.d ]]; then
    for _f in /etc/claude-code/managed-settings.d/*.json; do
        [[ -f "$_f" ]] && _settings_files+=("$_f")
    done
fi
# Project scope completes the chain (managed -> user -> project -> local): the key
# is documented as working from any scope, so a repo's own settings can disable
# bypass mode too. Read from the host path ($current_dir) — $workspace is the
# in-sandbox path and isn't assigned until much later. Skipped under --tmp, where
# the workspace is never mounted and the warning would be a false positive.
[[ "$tmp_mode" != true ]] && \
    _settings_files+=("$current_dir/.claude/settings.json"
                      "$current_dir/.claude/settings.local.json")
for _settings_file in "${_settings_files[@]}"; do
    [[ -f "$_settings_file" && -r "$_settings_file" ]] || continue
    [[ "$(< "$_settings_file")" =~ $_disable_re ]] || continue
    echo "Warning: $_settings_file sets permissions.disableBypassPermissionsMode=\"disable\"." >&2
    echo "  This blocks --dangerously-skip-permissions which blaude always passes." >&2
    if [[ "$_settings_file" == /etc/claude-code/* ]]; then
        echo "  This is an enterprise-managed setting and can only be changed by your admin." >&2
    else
        echo "  Remove the key to restore bypass mode." >&2
    fi
    break  # one warning is enough
done
unset _disable_re _settings_files _settings_file _f

# --- Build bwrap command ---

bwrap_args=(
    # Lifecycle & security
    --cap-drop ALL
    --die-with-parent
    # Note: --new-session removed to allow proper signal propagation for MCP servers
    # and background tasks. PID namespace provides equivalent process isolation.
    # Namespace isolation
    --unshare-pid --unshare-ipc --unshare-uts
    --hostname blaude
)

bwrap_args+=(--unshare-user --uid "$sandbox_uid" --gid "$sandbox_gid")

# --- Mount helpers ---
# Bind <path> at its own location if it exists.
# kind: f (file), d (directory), or e (exists — for symlinks etc.)
# mode: ro-bind or bind
_bind_if_exists() {
    local path="$1" kind="$2" mode="$3"
    [[ -z "$path" ]] && return
    case "$kind" in
        f) [[ -f "$path" ]] || return ;;
        d) [[ -d "$path" ]] || return ;;
        e) [[ -e "$path" ]] || return ;;
        *) echo "_bind_if_exists: invalid kind '$kind'" >&2; exit 1 ;;
    esac
    case "$mode" in
        bind|ro-bind) ;;
        *) echo "_bind_if_exists: invalid mode '$mode'" >&2; exit 1 ;;
    esac
    bwrap_args+=(--"$mode" "$path" "$path")
}
# Ensure directory exists (creating if needed), then bind-mount it read-write
# at its own location (every caller needs rw persistence).
_ensure_and_bind() {
    [[ -d "$1" ]] || mkdir -p "$1" 2>/dev/null
    _bind_if_exists "$1" d bind
}
# Mount a host directory so its contents stay readable but writes are discarded
# on exit — for host state the agent should read but never durably change
# (~/.config, the npm/uv/bun caches). Read-only would be simpler but breaks real
# use: yarn globals live under ~/.config/yarn, ~/.config/google-chrome is a
# browser profile Chrome can't start against read-only, and a read-only cache
# makes npm/uv installs fail rather than degrade.
#
# fallback: what to emit when bwrap predates 0.8.0 and can't overlay —
#   bind  (default) keep today's read-write behaviour, no regression
#   tmpfs            blank writable dir, for callers that are a tmpfs today and
#                    would otherwise be *newly* exposed by a bind fallback
# Only-if-directory, like _bind_if_exists: --tmp-overlay on a missing path makes
# bwrap materialize the mountpoint, which for a host-bound parent is a host stub.
_overlay_or_bind() {
    local path="$1" fallback="${2:-bind}"
    [[ -d "$path" ]] || return
    # --allow-protected-writes already means "let the agent write host state".
    # Checked per call rather than around the call sites: they sit ~300 lines
    # apart, so one guard here beats four. The workspace protected-paths block
    # wraps its whole body in the same test instead, because there the call
    # sites are contiguous — deliberate twins, not an inconsistency.
    if [[ "$allow_protected_writes" == true ]]; then
        _bind_if_exists "$path" d bind
    elif [[ "$overlay_supported" == true ]]; then
        bwrap_args+=(--overlay-src "$path" --tmp-overlay "$path")
    elif [[ "$fallback" == tmpfs ]]; then
        bwrap_args+=(--tmpfs "$path")
    else
        _bind_if_exists "$path" d bind
        _overlay_fallback_paths+=("$path")
    fi
}
_dbg() { [[ "$debug" == true ]] && echo "$@" >&2; }

# Refuse $HOME as mount target or workspace unless --allow-protected-writes.
# action: short verb-phrase inserted into the error message ("mount ...",
# "sandbox home directory as workspace", etc.). extra: optional extra hint line
# (defaults to "Use --allow-protected-writes to override.").
_reject_if_home() {
    local resolved="$1" action="$2" extra="${3:-Use --allow-protected-writes to override.}"
    [[ "$allow_protected_writes" == true ]] && return
    [[ "$resolved" != "$HOME" ]] && return
    echo "Error: Refusing to $action." >&2
    echo "  $extra" >&2
    exit 1
}

# Single sources for the workspace scans below. Noise dirs are pruned for scan
# cost (not security) and keep cold-cache scans sub-second on monorepos. The
# protected-dotfile set feeds both the static top-level pass and the nested
# find — drift between two hand-kept copies would weaken the guarantee.
_protected_dotfiles=(.bashrc .bash_profile .bash_login .zshrc .zprofile .zshenv
                     .zlogin .profile .gitconfig .gitmodules .ripgreprc .mcp.json)
# Build a find name-alternation ("-name a -o -name b ...") into the named array.
_name_expr() {
    local -n _ne_out=$1; shift
    _ne_out=(-name "$1"); shift
    local _n
    for _n in "$@"; do _ne_out+=(-o -name "$_n"); done
}
_name_expr _noise_expr node_modules target dist build .venv vendor __pycache__
_name_expr _dotfile_expr "${_protected_dotfiles[@]}"

# Set the named variable to the most recently modified existing dir among the
# args (pass a glob; an unmatched glob passes through as a literal and fails -d).
_newest_dir() {
    local -n _nd_out=$1; shift
    local _d
    for _d in "$@"; do
        [[ -d "$_d" && ( -z "$_nd_out" || "$_d" -nt "$_nd_out" ) ]] && _nd_out="$_d"
    done
    return 0
}

# Warn about symlinks inside <root> whose targets escape it. bwrap mounts
# don't follow these, but if the target happens to be writable via another
# mount (e.g. -m ~/secrets:rw), Claude could traverse the link unexpectedly.
# Skips in-tree targets and known-safe system paths.
_scan_workspace_symlinks() {
    local root="$1" target rel header_shown=false i
    local -a links=() targets=()
    mapfile -d '' links < <(find "$root" -maxdepth 4 \
                 \( "${_noise_expr[@]}" -o -name .git \) -prune \
                 -o -type l -print0 2>/dev/null)
    ((${#links[@]})) || return 0
    # One readlink fork for all links, not one per link. -m resolves even when
    # the target is missing — broken symlinks are still a smell (target may
    # appear later via mount/race) — and always prints, so indexes stay paired.
    mapfile -d '' targets < <(readlink -mz -- "${links[@]}" 2>/dev/null)
    for i in "${!links[@]}"; do
        target="${targets[i]:-}"
        [[ -z "$target" ]] && continue
        case "$target" in
            "$root"|"$root"/*) continue ;;
            /usr/*|/lib/*|/lib32/*|/lib64/*|/bin/*|/sbin/*) continue ;;
            /etc/*|/proc/*|/sys/*|/dev/*) continue ;;
        esac
        if [[ "$header_shown" == false ]]; then
            echo "Warning: workspace contains symlinks pointing outside the tree:" >&2
            header_shown=true
        fi
        rel="${links[i]#"$root"/}"
        printf '  %s -> %s\n' "$rel" "$target" >&2
    done
}

# System mounts (read-only)
bwrap_args+=(--ro-bind /usr /usr)
_bind_if_exists /lib d ro-bind
_bind_if_exists /lib64 d ro-bind
_bind_if_exists /lib32 d ro-bind
bwrap_args+=(--ro-bind /bin /bin)
_bind_if_exists /sbin d ro-bind
# Mount /etc read-only, but handle resolv.conf symlink specially for WSL2/systemd
# bwrap's --file and bind mounts follow symlinks, so if /etc/resolv.conf is a symlink
# to e.g. /run/systemd/resolve/stub-resolv.conf, we need to create that target path
# See: https://github.com/containers/bubblewrap/issues/390
# Note: The actual symlink target mount is added AFTER base args (--tmpfs /run) below
resolv_symlink_target=""
resolv_fd=""
_setup_resolv() {
    [[ -L /etc/resolv.conf ]] || return
    # readlink (no -f): need the raw link target to distinguish absolute vs relative.
    local resolv_target content
    resolv_target=$(readlink /etc/resolv.conf)
    # -r first so a dangling symlink returns quietly: no 2>/dev/null on the read,
    # since that silently defeats the bash file-read optimization (same gotcha as
    # the settings scan above).
    [[ -r /etc/resolv.conf ]] || return
    content=$(</etc/resolv.conf)
    [[ -n "$content" ]] || return
    # Carry the content on a file descriptor, not a temp file: bwrap's
    # --ro-bind-data copies from the fd into its own tmpfs, so there is no host
    # artifact to secure, no name for the sandbox to attack, and nothing to clean
    # up. It also sidesteps a lifetime trap — a temp file would have to outlive
    # `exec` (bwrap opens its --ro-bind source only after replacing us) yet still
    # be removed eventually. `exec {fd}<` deliberately does not set FD_CLOEXEC, so
    # the descriptor survives exec, and the osc52-clipboard PTY proxy (execvp, no
    # fd scrubbing) passes it through as well.
    # \n restores the trailing newline $(<...) strips.
    exec {resolv_fd}< <(printf '%s\n' "$content") || { resolv_fd=""; return; }
    # Absolute symlink - create target path after --tmpfs /run is added below
    [[ "$resolv_target" == /* ]] && resolv_symlink_target="$resolv_target"
}
_setup_resolv
bwrap_args+=(--ro-bind /etc /etc)

# Writable overlay for pyenv shims (pyenv init tries to write here)
if [[ -d /usr/share/pyenv/shims ]]; then
    bwrap_args+=(--tmpfs /usr/share/pyenv/shims)
fi

bwrap_args+=(
    --dev /dev
    --proc /proc
)
# /tmp: bind host's /tmp by default, use tmpfs with --clear-tmp
if [[ "$clear_tmp_mode" == true ]]; then
    bwrap_args+=(--tmpfs /tmp)
else
    bwrap_args+=(--bind /tmp /tmp)
    # The host bind also exposes /tmp's IPC endpoints, which are reachable
    # because the sandbox runs as the same uid that owns them. A live tmux
    # server's socket is the sharpest: `tmux send-keys` types into a host shell,
    # which is immediate host code execution, not the deferred kind the rest of
    # the sandbox guards against. An ssh-agent socket under /tmp/ssh-XXXX/ is an
    # opt-out bypass of the --ssh gate, and a /tmp/dbus-* socket bypasses
    # --keyring the same way. Shadow each with an empty tmpfs; later bwrap_args
    # override the /tmp bind at these paths.
    #
    # Only-if-present is load-bearing: --tmpfs on a missing path makes bwrap
    # create the mountpoint, and under a host-bound /tmp that is a real host dir.
    #
    # Two gaps this deliberately does not close (--clear-tmp is the complete
    # answer): bare socket *files* at the /tmp root — /tmp/.s.PGSQL.5432,
    # /tmp/mysql.sock — can't be shadowed by a tmpfs without covering /tmp
    # itself, and a tmux server started *after* launch creates its socket dir
    # mid-session, unshadowed.
    if [[ "$allow_protected_writes" != true ]]; then
        for _tmp_sock in /tmp/.X11-unix /tmp/.ICE-unix /tmp/.XIM-unix /tmp/.font-unix \
                         /tmp/tmux-* /tmp/ssh-* /tmp/dbus-*; do
            [[ -d "$_tmp_sock" ]] && bwrap_args+=(--tmpfs "$_tmp_sock")
        done
        unset _tmp_sock
    fi
fi
bwrap_args+=(
    --tmpfs /var
    --tmpfs /run
    # tmpfs (not --dir) so accidental host re-binds under /run/user/ get blocked.
    # Wayland/PipeWire/D-Bus sockets only appear via explicit later --bind.
    # XDG_RUNTIME_DIR is set after --clearenv (search for it below).
    --tmpfs "/run/user/$sandbox_uid"
)

# D-Bus session bus access (optional, for keytar/GNOME Keyring/Secret Service)
# Disabled by default - MCP servers fall back to file-based token storage
# Enable with --keyring flag if you have GNOME Keyring properly configured
if [[ "$keyring_mode" == true ]]; then
    dbus_socket=""
    if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
        if [[ "$DBUS_SESSION_BUS_ADDRESS" == *"unix:path="* ]]; then
            dbus_socket="${DBUS_SESSION_BUS_ADDRESS#*unix:path=}"
            dbus_socket="${dbus_socket%%,*}"
        elif [[ "$DBUS_SESSION_BUS_ADDRESS" == *"unix:abstract="* ]]; then
            # Surface unconditionally: --keyring was explicitly requested but won't work.
            echo "Warning: D-Bus uses abstract socket (won't work in sandbox)" >&2
        fi
    fi
    [[ -z "$dbus_socket" ]] && dbus_socket="/run/user/$_host_uid/bus"

    if [[ -S "$dbus_socket" ]]; then
        bwrap_args+=(--bind "$dbus_socket" "$dbus_socket")
        _dbg "Binding D-Bus session socket: $dbus_socket"
    fi
fi

# Complete resolv.conf symlink handling (deferred from above, after --tmpfs /run)
if [[ -n "$resolv_symlink_target" ]]; then
    # Create the symlink target directory and mount our content there
    bwrap_args+=(--dir "${resolv_symlink_target%/*}")
    bwrap_args+=(--ro-bind-data "$resolv_fd" "$resolv_symlink_target")
elif [[ -n "$resolv_fd" ]]; then
    # Relative symlink case - bind mount over /etc/resolv.conf
    bwrap_args+=(--ro-bind-data "$resolv_fd" /etc/resolv.conf)
fi

# Handle custom temp directory if CLAUDE_CODE_TMPDIR is set
# Claude appends /claude/ to this path for its temp files
if [[ -n "${CLAUDE_CODE_TMPDIR:-}" && "$CLAUDE_CODE_TMPDIR" != "/tmp" ]]; then
    # Ensure the custom tmpdir is writable inside the sandbox
    bwrap_args+=(--tmpfs "$CLAUDE_CODE_TMPDIR")
fi

# Minimal home exposure: tmpfs $HOME with scaffolded writable dirs
# (pkg managers, caches — ephemeral, cleared on sandbox exit).
bwrap_args+=(--tmpfs "$HOME")
for _d in .local .local/bin .local/share .local/lib \
          .cache go go/bin go/pkg .cargo .cargo/bin .cargo/registry; do
    bwrap_args+=(--dir "$HOME/$_d")
done
unset _d

# GNOME Keyring storage (optional, only with --keyring flag)
if [[ "$keyring_mode" == true ]]; then
    keyrings_dir="$HOME/.local/share/keyrings"
    _dbg "Binding GNOME Keyring storage: $keyrings_dir"
    _ensure_and_bind "$keyrings_dir"
fi

# npm cache: overlay the host's cache if it exists (readable, so npx-based MCP
# servers still resolve offline; writes discarded, so a poisoned _cacache entry
# can't reach the host's own `npm install`), otherwise seed an ephemeral
# _cacache subdir.
if [[ -d "$HOME/.npm" ]]; then
    _overlay_or_bind "$HOME/.npm"
else
    bwrap_args+=(--dir "$HOME/.npm" --dir "$HOME/.npm/_cacache")
fi

# Bind host's user binaries and their backing virtual environments
# Many tools in ~/.local/bin are symlinks to pipx/uv venvs
bwrap_args+=(--dir /opt)

# Mount a host directory under /opt/<name>, read-only (bwrap auto-creates the
# mount point, same as every other bind DEST).
_mount_host_bin() {
    local host="$1" name="$2"
    [[ -d "$host" ]] || return
    bwrap_args+=(--ro-bind "$host" "/opt/$name")
}

_mount_host_bin "$HOME/.local/bin" host-bin

# Some host tools are /usr/bin front-end symlinks (FHS "add-on package" pattern)
# whose real binary lives under /opt — sometimes via an /etc/alternatives hop, e.g.
#   pwsh                 -> /opt/microsoft/powershell/7/pwsh
#   google-chrome-stable -> /opt/google/chrome/google-chrome
#   microsoft-edge       -> /opt/microsoft/msedge/microsoft-edge
# The empty `--dir /opt` above shadows those targets, so the symlinks dangle and
# the tools vanish in-sandbox even though /usr/bin is on PATH. For each known tool
# whose resolved path (readlink -f follows the whole chain) lands in /opt, bind its
# install dir read-only so the symlink resolves. Browsers matter for headless
# automation MCP servers (Playwright/Puppeteer/chrome-devtools) — note Chrome must
# be launched with --no-sandbox inside bwrap. Snap installs resolve to /snap (need
# snap's loopback-mount machinery) and are skipped safely by the /opt guard. An
# unlisted /opt tool can still be exposed on demand with `-m /opt/<vendor>/<tool>`.
_mount_opt_frontend_tools() {
    local real dir
    local -A seen=()
    local -a bins=()
    # Two forks total (command -v prints one line per *found* tool; readlink
    # batch-resolves them) instead of up to two forks per listed tool.
    mapfile -t bins < <(command -v pwsh pwsh-preview \
        google-chrome google-chrome-stable chromium chromium-browser \
        microsoft-edge microsoft-edge-stable brave-browser dotnet 2>/dev/null)
    ((${#bins[@]})) || return 0
    while IFS= read -r -d '' real; do
        # Require >=2 levels under /opt (/opt/<vendor>/<bin>...) so stripping the
        # basename can never collapse to /opt itself and ro-bind the whole host
        # /opt — that would undo the deliberate empty `--dir /opt` boundary.
        case "$real" in /opt/*/*) ;; *) continue ;; esac
        dir="${real%/*}"
        [[ -n "${seen[$dir]:-}" ]] && continue
        seen[$dir]=1
        _bind_if_exists "$dir" d ro-bind
    done < <(readlink -fz -- "${bins[@]}" 2>/dev/null)
}
_mount_opt_frontend_tools

# Bind claude binary (Claude Code checks for itself there).
# Uses 'e' kind so symlinks to claude are also bound.
_bind_if_exists "$HOME/.local/bin/claude" e ro-bind

# Bind pipx virtual environments (symlink targets for pipx-installed tools)
_bind_if_exists "$HOME/.local/share/pipx" d ro-bind

# Bind uv tools directory (for uv-installed MCP servers like notebooklm-mcp)
# These are symlink targets for tools in ~/.local/bin installed via `uv tool install`
_bind_if_exists "$HOME/.local/share/uv/tools" d ro-bind

# Bind uv-managed Python installations (some uv tools use these instead of system Python)
_bind_if_exists "$HOME/.local/share/uv/python" d ro-bind

# uv cache: overlay if it exists for faster tool installs (writes discarded, so
# cache poisoning can't reach the host's own uv), else leave ephemeral. uv's
# default link-mode=hardlink can't hardlink across the overlay into a workspace
# venv, so it falls back to copying — slower, but it degrades gracefully.
_overlay_or_bind "$HOME/.cache/uv"

# Resolve symlinks under a package manager directory, find their package roots,
# and mount them read-only. Also mounts MCP token files read-write for persistence.
# Results are cached across launches; rebuild when scan_root's mtime is newer than
# the cache file (the readlink -f fork per symlink is the dominant startup cost on
# a populated nvm/bun tree). Uses bash's `-nt` (stat(2), no fork) — NOT a `stat -c`
# subshell.
# Cache-key caveat: directory mtime only bumps when direct children change, so a
# new symlink nested deep under scan_root (e.g. a grandchild added by `npm i -g`)
# won't invalidate the cache. Workaround: `rm ~/.cache/blaude/pkgmount-*`.
# Usage: _mount_linked_packages <label> <exclude_prefix> <find_args...>
_mount_linked_packages() {
    local label="$1" exclude_prefix="$2"
    shift 2
    local scan_root="$1" scan_key
    scan_key=${scan_root//\//_}
    local cache_file="${_cache_dir}/pkgmount-${label}-${scan_key}-${_host_uid}"
    local -a link_targets=()

    if [[ -f "$cache_file" && ! "$scan_root" -nt "$cache_file" ]]; then
        while IFS= read -r line; do
            # Defense-in-depth: re-verify each cached path is a real package
            # root outside $HOME before trusting it for a mount. A poisoned
            # cache must not be able to bind arbitrary host dirs into the sandbox.
            [[ -n "$line" && -d "$line" && -f "$line/package.json" && "$line" != "$HOME" ]] \
                && link_targets+=("$line")
        done < "$cache_file"
    else
        local -A seen=()
        local -a scan_symlinks=()
        local target
        mapfile -d '' scan_symlinks < <(find "$@" -print0 2>/dev/null)
        # Batch-resolve every symlink in one readlink fork — the per-symlink
        # fork was the dominant cold-scan cost on a populated nvm/bun tree.
        # Only the targets are consumed, so unresolvable links simply drop out.
        while IFS= read -r -d '' target; do
            [[ -z "$target" || "$target" == "$exclude_prefix"* ]] && continue
            # Walk up to package root (directory with package.json)
            local link_dir="$target"
            while [[ "$link_dir" != "/" && "$link_dir" != "$HOME" && ! -f "$link_dir/package.json" ]]; do
                link_dir=${link_dir%/*}
                [[ -z "$link_dir" ]] && link_dir=/
            done
            if [[ -f "$link_dir/package.json" && "$link_dir" != "$HOME" && -z "${seen[$link_dir]:-}" ]]; then
                seen[$link_dir]=1
                link_targets+=("$link_dir")
            fi
        done < <( ((${#scan_symlinks[@]})) && readlink -fz -- "${scan_symlinks[@]}" 2>/dev/null )
        printf '%s\n' "${link_targets[@]}" > "$cache_file" 2>/dev/null || true
    fi

    # When a package root sits inside a node_modules/ directory (bun's flat
    # global layout, scoped or unscoped), mount the whole node_modules so
    # transitive sibling deps resolve. Otherwise mount the package alone.
    local -A mount_seen=()
    for link_target in "${link_targets[@]}"; do
        local parent="${link_target%/*}"
        local parent_name="${parent##*/}"
        local mount_root="$link_target"
        if [[ "$parent_name" == "node_modules" ]]; then
            mount_root="$parent"
        elif [[ "$parent_name" == @* ]]; then
            local grandparent="${parent%/*}"
            [[ "${grandparent##*/}" == "node_modules" ]] && mount_root="$grandparent"
        fi
        if [[ "$mount_root" != "$HOME" && -z "${mount_seen[$mount_root]:-}" ]]; then
            mount_seen[$mount_root]=1
            _dbg "Auto-mounting ${label}-linked: $mount_root"
            _bind_if_exists "$mount_root" d ro-bind
        fi
        # MCP token files — create if needed for bind mount, mount read-write for persistence.
        # Added after the parent ro-bind so bwrap's later-overrides-earlier rule keeps them writable.
        for token_file in ".token-cache.json" ".selected-account.json"; do
            local token_path="$link_target/$token_file"
            [[ ! -f "$token_path" ]] && : > "$token_path" 2>/dev/null
            if [[ -f "$token_path" ]]; then
                _dbg "  Mounting token file read-write: $token_path"
                bwrap_args+=(--bind "$token_path" "$token_path")
            fi
        done
    done
}

# Bind NVM (Node Version Manager) for npx-based MCP servers
# NVM installs Node.js to ~/.nvm/versions/node/<version>/
nvm_installed=false
nvm_dir="$HOME/.nvm"
if [[ -d "$nvm_dir" ]]; then
    nvm_installed=true
    _bind_if_exists "$nvm_dir" d ro-bind
    _mount_linked_packages "npm" "$nvm_dir" \
        "$nvm_dir/versions" -type l -path "*/node_modules/*"
fi

# Bind fnm (Fast Node Manager). fnm installs Node to
# $FNM_DIR/node-versions/<v>/installation/ and exposes the active version via a
# per-shell symlink $FNM_MULTISHELL_PATH (under $XDG_RUNTIME_DIR, an empty tmpfs
# in-sandbox), so we mount the real $FNM_DIR and (in the PATH section below) point
# PATH at the resolved installation bin dir. `fnm env` always exports FNM_DIR, so
# custom dirs are honored.
fnm_installed=false
fnm_dir="${FNM_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/fnm}"
if [[ -d "$fnm_dir" ]]; then
    fnm_installed=true
    _bind_if_exists "$fnm_dir" d ro-bind
    _mount_linked_packages "npm" "$fnm_dir" \
        "$fnm_dir/node-versions" -type l -path "*/node_modules/*"
fi

# Secondary Node package managers keep global installs / bin shims / caches OUTSIDE
# the node-manager dir, so the fnm/nvm mounts don't cover them. Mount read-only and
# (in the PATH section below) wire global bin dirs onto PATH. Gated on existence —
# tool-agnostic, so this also benefits nvm/bun users.
# pnpm: bins in $PNPM_HOME/bin; isolated globals + content store under $PNPM_HOME.
pnpm_home="${PNPM_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/pnpm}"
if [[ -d "$pnpm_home" ]]; then
    _bind_if_exists "$pnpm_home" d ro-bind
    # `pnpm link --global` / `pnpm add -g <local dir>` symlinks escaping $PNPM_HOME.
    # Scope to global/ — never scan the (huge) content store.
    _mount_linked_packages "npm" "$pnpm_home" \
        "$pnpm_home/global" -type l -path "*/node_modules/*"
fi
# corepack: shims live in node's bin (already mounted); real pnpm/yarn cached here.
corepack_home="${COREPACK_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/node/corepack}"
_bind_if_exists "$corepack_home" d ro-bind
# yarn classic global bins (globals in ~/.config/yarn, already rw-mounted).
_bind_if_exists "$HOME/.yarn" d ro-bind

_mount_host_bin "$HOME/.cargo/bin" host-cargo-bin
_mount_host_bin "$HOME/go/bin" host-go-bin

# Bind claude's data directory read-only if it exists
# DISABLE_AUTOUPDATER=1 is set below, so no write access needed
_bind_if_exists "$HOME/.local/share/claude" d ro-bind

# $config_dir is bound after the ~/.config overlay below — mount order matters.

# Mount ~/.claude.json (OAuth session, MCP servers, preferences, caches)
_bind_if_exists "$HOME/.claude.json" f bind

# npx-installed skills (vercel-labs `skills`): canonical content lives in
# ~/.agents/skills/<name>; ~/.claude/skills/<name> is a relative symlink to it.
# Mount read-only so global-scope skills resolve inside the sandbox (project-scope
# skills already work — both dirs live in the mounted workspace).
_bind_if_exists "$HOME/.agents" d ro-bind

# claudechic config file (~/.claude/.claudechic.yaml) is already accessible
# via the config_dir mount below — do NOT bind-mount it directly, as claudechic
# uses atomic writes (os.replace) which fail on bind-mounted files.

# claudechic debug log (only needed if CLAUDECHIC_DEBUG is set)
if [[ -n "${CLAUDECHIC_DEBUG:-}" ]]; then
    claudechic_log="$HOME/claudechic.log"
    [[ -f "$claudechic_log" ]] || : > "$claudechic_log" 2>/dev/null
    _bind_if_exists "$claudechic_log" f bind
fi

# notebooklm-mcp auth directories (token cache, Chrome profiles, config)
for notebooklm_dir in "$HOME/.notebooklm-mcp" "$HOME/.notebooklm-mcp-cli"; do
    _ensure_and_bind "$notebooklm_dir"
done

# User config directory (~/.config/)
# Includes uv config (python-preference), fabric, google-chrome, and other tool configs.
# Overlaid rather than bound read-write: the tree also holds autostart/,
# systemd/user/, environment.d/, Code/User/settings.json and nvim/init.lua, each
# of which executes on the *host* at next login or next app launch. Claude Code
# 2.1.160 prompts before such writes, but blaude passes
# --dangerously-skip-permissions, so bwrap is the only guard. An overlay keeps
# every consumer working (yarn globals, the Chrome profile, gh's token all stay
# readable) while discarding the writes, and needs no denylist of dangerous
# subdirectories.
_overlay_or_bind "$HOME/.config"
# ~/.config/git (XDG global git config) holds settings — aliases,
# core.pager/editor/fsmonitor, core.sshCommand — that execute on the *host* at the
# next git run outside the sandbox. Claude Code 2.1.160 prompts before writing it,
# but blaude passes --dangerously-skip-permissions (which bypasses that prompt), so
# re-shadow it here, mirroring the workspace .gitconfig guard:
#   existing dir -> read-only (content readable, writes blocked, no host artifact)
#   missing dir  -> ephemeral tmpfs (blocks host file creation)
# Redundant while the overlay above is active (writes there are discarded anyway),
# and kept unconditional precisely so it still holds on the no-overlay fallback
# path, where ~/.config reverts to a plain rw bind. Two spare bwrap args are
# cheaper than making this protection depend on another feature's availability.
if [[ "$allow_protected_writes" != true && -d "$HOME/.config" ]]; then
    if [[ -d "$HOME/.config/git" ]]; then
        bwrap_args+=(--ro-bind "$HOME/.config/git" "$HOME/.config/git")
    else
        bwrap_args+=(--tmpfs "$HOME/.config/git")
    fi
fi

# Ensure config directory exists on host, then bind-mount (bwrap --bind auto-creates DEST).
# Must come after the ~/.config overlay above: bwrap applies mounts in argument
# order, so a CLAUDE_CONFIG_DIR under ~/.config (e.g. ~/.config/claude) bound
# first would be covered by the parent overlay, and every session, history.jsonl
# entry, project-trust record and refreshed OAuth credential would land in the
# tmpfs upper layer and vanish at exit — silently breaking `blaude -c`/--resume
# and re-prompting for login on every launch.
_ensure_and_bind "$config_dir"

# arxiv-storage directory (for research paper management tools)
_bind_if_exists "$HOME/arxiv-storage" d bind

# Claude memory directory (for persistent memory across sessions)
# Auto-create if claude-mem plugin is installed but data dir doesn't exist yet
if [[ ! -d "$HOME/.claude-mem" ]]; then
    if [[ -d "$config_dir/plugins/marketplaces/thedotmack" || \
          -d "$config_dir/plugins/cache/claude-mem" ]]; then
        mkdir -p "$HOME/.claude-mem"
    elif [[ -r "$config_dir/plugins/installed_plugins.json" ]] && \
         [[ "$(< "$config_dir/plugins/installed_plugins.json")" == *\"claude-mem\"* ]]; then
        mkdir -p "$HOME/.claude-mem"
    fi
fi
_bind_if_exists "$HOME/.claude-mem" d bind

# Bun runtime and package manager
if [[ -d "$HOME/.bun" ]]; then
    _bind_if_exists "$HOME/.bun" d ro-bind
    # Bun runtime needs writable install cache (plugins like claude-mem run bun install)
    # Overlay rather than a blank tmpfs so the host cache stays readable (bun no
    # longer re-downloads every session) while writes are still discarded. Falls
    # back to the old tmpfs, not a bind, so an overlay-less bwrap can't newly
    # expose a directory that is hidden today.
    _overlay_or_bind "$HOME/.bun/install/cache" tmpfs
    # Scan bin/ and global node_modules/ separately to avoid traversing ~/.bun/install/cache
    _mount_linked_packages "bun" "$HOME/.bun" \
        "$HOME/.bun/bin" -type l
    _mount_linked_packages "bun" "$HOME/.bun" \
        "$HOME/.bun/install/global/node_modules" -type l
fi

# Network isolation
if [[ "$no_network" == true ]]; then
    bwrap_args+=(--unshare-net)
fi

# Bind a file/dir named by an env var, if set and existing, at its host path.
# kind: f (file) or d (directory); mode: ro-bind or bind
_bind_env_path() { _bind_if_exists "${!1:-}" "$2" "$3"; }

# Add --setenv VAR=<host value> to bwrap_args iff VAR is set and non-empty.
_setenv_if_set() { [[ -n "${!1:-}" ]] && bwrap_args+=(--setenv "$1" "${!1}"); }

# Git mode: mount git config, GPG agent socket dir, and pass GitHub tokens
if [[ "$git_mode" == true ]]; then
    _bind_if_exists "$HOME/.gitconfig" f ro-bind
    _bind_if_exists "$HOME/.git-credentials" f ro-bind
    # GPG agent socket (for signed commits with commit.gpgsign=true).
    # gpgconf is the canonical way to discover the socket dir — handles
    # XDG_RUNTIME_DIR/gnupg vs ~/.gnupg vs custom GNUPGHOME transparently.
    if command -v gpgconf &>/dev/null; then
        _bind_if_exists "$(gpgconf --list-dirs socketdir 2>/dev/null)" d bind
    fi
    # GNUPGHOME may point to a non-default keyring location — mount read-only.
    _bind_env_path GNUPGHOME d ro-bind
    # GitHub tokens (for gh CLI, git push/pull, MCP servers)
    for var in GH_TOKEN GITHUB_TOKEN; do
        _setenv_if_set "$var"
    done
fi

# SSH mode: mount SSH keys and forward SSH agent
ssh_agent_ok=false  # socket validated once here; the env section reuses the verdict
if [[ "$ssh_mode" == true ]]; then
    _bind_if_exists "$HOME/.ssh" d ro-bind
    # Bind the socket's parent dir so socket re-creation by systemd-tmpfile
    # (e.g. after `systemctl --user restart ssh-agent`) stays visible.
    if [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]]; then
        ssh_agent_ok=true
        _bind_if_exists "${SSH_AUTH_SOCK%/*}" d bind
    fi
fi

# AWS mode: mount AWS config/credentials for Bedrock authentication
if [[ "$aws_mode" == true ]]; then
    _bind_if_exists "$HOME/.aws" d ro-bind
fi

# Files (mTLS, CA bundles, token files, env file, GCP creds) — read-only.
# GOOGLE_APPLICATION_CREDENTIALS is Vertex-facing and shouldn't require --aws.
# CLAUDE_CLIENT_PRESENCE_FILE (2.1.181): prefix-match passes the value, but it
# names a marker file claude reads (screen-lock status for Remote Control mobile
# push) — bind it read-only so the path resolves inside the sandbox.
# The OTEL_EXPORTER_OTLP_*CLIENT_KEY/CERTIFICATE pairs are the grpc OTLP mTLS
# credentials (the http/protobuf path uses CLAUDE_CODE_CLIENT_CERT/KEY instead),
# and OTEL_EXPORTER_OTLP_CERTIFICATE is the collector's CA bundle. Passing the
# values without binding the files leaves the exporter pointed at paths that
# don't exist in the sandbox.
# CLAUDE_CODE_SHELL names the bash/zsh binary for the Bash tool; a host path
# such as /opt/homebrew/bin/bash would dangle under blaude's empty /opt. Claude
# Code falls back to auto-detection on an unusable value, so this only avoids
# silently ignoring the user's choice.
for var in CLAUDE_ENV_FILE CLAUDE_CODE_CLIENT_CERT CLAUDE_CODE_CLIENT_KEY \
           AWS_WEB_IDENTITY_TOKEN_FILE NODE_EXTRA_CA_CERTS \
           GOOGLE_APPLICATION_CREDENTIALS CLAUDE_CLIENT_PRESENCE_FILE \
           CLAUDE_CODE_SHELL \
           OTEL_EXPORTER_OTLP_CLIENT_KEY OTEL_EXPORTER_OTLP_CLIENT_CERTIFICATE \
           OTEL_EXPORTER_OTLP_CERTIFICATE \
           OTEL_EXPORTER_OTLP_METRICS_CLIENT_KEY \
           OTEL_EXPORTER_OTLP_METRICS_CLIENT_CERTIFICATE; do
    _bind_env_path "$var" f ro-bind
done

# Directories — read-only (skill dir is inert data)
_bind_env_path CLAUDE_SKILL_DIR d ro-bind

# Directories — read-write. The *_DIR overrides below default under ~/.claude
# (already mounted); the explicit bind only matters when one is pointed at a
# custom host path — bind it rw so claude can persist there. Bind-if-exists,
# matching the other claude-managed dirs.
for var in CLAUDE_CODE_PLUGIN_CACHE_DIR CLAUDE_PLUGIN_DATA \
           CLAUDE_CODE_WORKSPACE_DIR CLAUDE_LOGS_DIR CLAUDE_MCP_STDERR_LOG_DIR \
           CLAUDE_SESSION_METADATA_DIR CLAUDE_CODE_WORKSPACE_STATE_DIR; do
    _bind_env_path "$var" d bind
done

# CLAUDE_CODE_DEBUG_LOGS_DIR is a FILE path despite its name (the debug log
# file, default ~/.claude/debug/<session-id>.txt). The file won't exist yet,
# so bind its parent directory read-write to let claude create it. Binding
# the value itself as a directory would silently skip a custom file path.
if [[ -n "${CLAUDE_CODE_DEBUG_LOGS_DIR:-}" ]]; then
    _bind_if_exists "${CLAUDE_CODE_DEBUG_LOGS_DIR%/*}" d bind
fi

# CLAUDE_CODE_PLUGIN_SEED_DIR: colon-separated list of directories (Claude Code 2.1.79+)
if [[ -n "${CLAUDE_CODE_PLUGIN_SEED_DIR:-}" ]]; then
    IFS=':' read -ra _seed_dirs <<< "$CLAUDE_CODE_PLUGIN_SEED_DIR"
    for _seed_dir in "${_seed_dirs[@]}"; do
        _bind_if_exists "$_seed_dir" d ro-bind
    done
    unset _seed_dirs _seed_dir
fi

# Launcher/wrapper executables. Both vars hold an argv *prefix* (e.g.
# "/opt/corp/launcher --profile claude"), not a bare path, so bind only the first
# token. The prefix match passes the value; the binary would otherwise be missing.
# SHELL_PREFIX wraps every Bash tool call, hook, status-line command, and stdio MCP
# server startup, so a dangling path breaks all four. PROCESS_WRAPPER (2.1.208) is
# canonically under /opt, which blaude builds as an empty --dir — it dangles just
# like the /usr/bin -> /opt front-end symlinks handled above; its documented home is
# the settings env block, so a shell export (bound here) is the uncommon case.
# Only the executable is bound, not its parent dir: over-broad for a wrapper in
# ~/bin, and a launcher needing sibling files can be exposed with -m.
_bind_if_exists "${CLAUDE_CODE_SHELL_PREFIX%%[[:space:]]*}" f ro-bind
_bind_if_exists "${CLAUDE_CODE_PROCESS_WRAPPER%%[[:space:]]*}" f ro-bind

# Additional mount points
for mount_spec in "${mount_args[@]}"; do
    # Check for :rw suffix (read-write mode)
    if [[ "$mount_spec" == *":rw" ]]; then
        mount_mode="bind"
        mount_spec="${mount_spec%:rw}"  # Strip :rw suffix
    else
        mount_mode="ro-bind"
    fi

    # Expand ~ to $HOME
    host_path="${mount_spec/#\~/$HOME}"

    if [[ ! -e "$host_path" ]]; then
        echo "Error: Mount path does not exist: $host_path" >&2
        exit 1
    fi

    # Resolve symlinks and validate target
    resolved_path=$(readlink -f "$host_path")
    if [[ -z "$resolved_path" || ! -e "$resolved_path" ]]; then
        echo "Error: Mount path is a broken symlink: $host_path" >&2
        exit 1
    fi
    _reject_if_home "$resolved_path" "mount home directory: $host_path"
    if [[ "$resolved_path" != "$host_path" ]]; then
        echo "Warning: Mount path $host_path is a symlink to $resolved_path" >&2
        echo "  Mounting resolved target instead." >&2
        host_path="$resolved_path"
    fi

    bwrap_args+=(--"$mount_mode" "$host_path" "$host_path")
done

if [[ "$tmp_mode" == true ]]; then
    bwrap_args+=(--chdir /tmp)
else
    # Reject $HOME as workspace (would expose entire home directory read-write).
    # Skip the readlink -f fork entirely when the override is set.
    if [[ "$allow_protected_writes" != true ]]; then
        resolved_workspace=$(readlink -f "$current_dir")
        _reject_if_home "$resolved_workspace" "sandbox home directory as workspace" \
            "Use a subdirectory instead, --tmp, or --allow-protected-writes to override."
    fi

    workspace="/workspaces/$safe_dir_name"
    [[ "$allow_protected_writes" != true ]] && _scan_workspace_symlinks "$current_dir"
    bwrap_args+=(--bind "$current_dir" "$workspace")
    bwrap_args+=(--chdir "$workspace")

    # --- Mandatory protected paths ---
    # Inspired by Anthropic's sandbox-runtime: deny writes to files/directories that
    # could execute code outside the sandbox.
    #
    # Files: --ro-bind (preserves content, hard-blocks writes).
    # Directories: --tmp-overlay when available (content readable, writes ephemeral,
    # zero host artifacts), falling back to --ro-bind (hard-blocks writes but bwrap
    # creates host stubs for non-existent targets). When a protected child directory
    # doesn't exist, its parent is overlaid instead to prevent creation.
    # Root-level dotfiles (.bashrc etc.) have no overlayable parent — only protected
    # if they already exist (low risk: uncommon in project directories).
    if [[ "$allow_protected_writes" != true ]]; then
        # $overlay_supported is probed once near the top of the script.
        # A protected source must resolve — after following any symlink in its
        # path — to a location inside the workspace. Otherwise bwrap's bind would
        # mount the host target's content into the sandbox: a malicious
        # `.gitconfig -> ~/.ssh/id_rsa` or `.vscode -> ~/.aws` would leak host
        # files the sandbox is specifically designed to exclude.
        #
        # A symlink *at* the protected name cannot be protected at all: bwrap has
        # no way to avoid resolving a bind destination, so the ro-bind/overlay
        # lands on the link's target while the link itself stays an ordinary
        # dentry. Binding it anyway is actively harmful — it silently makes the
        # *target* write-discarding (a benign `packages/*/.vscode -> shared` loses
        # real edits) without protecting the name, which the sandbox can still
        # unlink and replace. So skip it and say so. Residual risk, accepted:
        # the name remains replaceable, exactly as before this guard existed —
        # closing that would mean refusing to launch, which breaks legitimate
        # shared-config symlinks. Use --allow-protected-writes to silence.
        _protected_src_ok() {
            local real
            [[ -n "$resolved_workspace" ]] || return 1   # fail closed: no root, no bind
            [[ -L "$1" ]] && \
                { echo "Warning: protected path ${1#"$current_dir"/} is a symlink — cannot protect it." >&2; return 1; }
            real=$(readlink -f "$1" 2>/dev/null) || return 1
            [[ "$real" == "$resolved_workspace" || "$real" == "$resolved_workspace"/* ]] && return 0
            _dbg "Skipping protection for $1 (resolves to $real, outside workspace)"
            return 1
        }
        if [[ "$overlay_supported" == true ]]; then
            _protect_dir() { _protected_src_ok "$1" || return; bwrap_args+=(--overlay-src "$1" --tmp-overlay "$2"); }
        else
            _protect_dir() { _protected_src_ok "$1" || return; bwrap_args+=(--ro-bind "$1" "$2"); }
        fi
        _protect_file() { _protected_src_ok "$1" || return; bwrap_args+=(--ro-bind "$1" "$2"); }
        # Protection strategy for a single gitdir: protect config + hooks/
        # individually when hooks/ exists; otherwise overlay the whole gitdir to
        # prevent hooks/ creation (also covers config).
        # Returns non-zero when it overlaid the whole gitdir, so callers know
        # everything beneath it is already covered.
        _protect_gitdir() {
            if [[ -d "$1/hooks" ]]; then
                [[ -f "$1/config" ]] && _protect_file "$1/config" "$2/config"
                _protect_dir "$1/hooks" "$2/hooks"
                return 0
            fi
            _protect_dir "$1" "$2"
            return 1
        }
        # .git protection, shared by the top-level and nested passes. Submodules
        # keep their real gitdir at .git/modules/<name>/ — arbitrarily nested for a
        # submodule in a subdir or a submodule of a submodule — so their config and
        # hooks/ sit far past the nested scan's maxdepth, and <sub>/.git is a
        # gitlink *file* that `-d`/`-type d` never match. They execute on the host
        # just like the top-level ones: core.fsmonitor in a submodule config fires
        # on a plain `git status` in the superproject, which recurses to compute
        # submodule dirtiness.
        _protect_git() {
            _protect_gitdir "$1" "$2" || return   # whole gitdir overlaid: modules/ included
            [[ -d "$1/modules" ]] && _protect_submodule_gitdirs "$1/modules" "$2/modules"
        }
        # A submodule's directory under modules/ is its *worktree path*, so the tree
        # is path segments until a directory holding a `config` file — the gitdir
        # root, which is then protected exactly like a top-level .git (hence the
        # mutual recursion through _protect_git, which also descends that gitdir's
        # own modules/ to reach a submodule of a submodule).
        #
        # Stopping at the root is what keeps the walk out of the object store, which
        # otherwise dominates the cost. It can't be done by name: `src/logs/lib` puts
        # a real gitdir behind a segment named `logs`, so pruning `objects`/`refs`/
        # `logs` by name — as this did before — silently skipped protecting it.
        # Keying on `config` alone is deliberate, and narrower than git's own
        # is_git_directory() (HEAD + objects/ + refs/): `config` is the file being
        # protected, so anything holding one must be guarded whether or not it is a
        # well-formed gitdir. Descending in bash rather than shelling out per
        # candidate directory keeps it forkless (40 submodules: 9.1ms -> 2.5ms).
        # Symlinks are skipped, matching find -P's old behaviour and, since the tree
        # is then acyclic, keeping the recursion terminating.
        _protect_submodule_gitdirs() {
            local d name
            for d in "$1"/* "$1"/.*; do   # second glob catches a dot-prefixed worktree path
                name="${d##*/}"
                [[ "$name" == . || "$name" == .. ]] && continue
                [[ -d "$d" && ! -L "$d" ]] || continue
                if [[ -f "$d/config" ]]; then
                    _protect_git "$d" "$2/$name"
                else
                    _protect_submodule_gitdirs "$d" "$2/$name"
                fi
            done
        }

        for f in "${_protected_dotfiles[@]}"; do
            [[ -f "$current_dir/$f" ]] && _protect_file "$current_dir/$f" "$workspace/$f"
        done

        # .git/* paths: only protect if .git is a directory (not a file, as in git worktrees)
        [[ -d "$current_dir/.git" ]] && _protect_git "$current_dir/.git" "$workspace/.git"

        # .claude/ left writable — skills and agents need to be modifiable

        # Only when present: no overlayable parent at the workspace root, and a
        # tmpfs shadow would leave an empty stub in every project (bwrap has to
        # materialize the mountpoint through the workspace bind).
        [[ -d "$current_dir/.vscode" ]] && _protect_dir "$current_dir/.vscode" "$workspace/.vscode"
        [[ -d "$current_dir/.idea" ]]   && _protect_dir "$current_dir/.idea" "$workspace/.idea"

        # Same protection for nested protected paths (monorepos, git submodules,
        # vendored deps). mindepth 2 skips the top-level (already done above).
        # maxdepth 3 catches submodules and one level of vendored deps without
        # exploding scan time on monorepos. One traversal: noise dirs are pruned
        # first; protected dirs are pruned-and-printed so we don't descend (which
        # also keeps dotfiles under a protected dir out of the file branch — they
        # would be shadowed by its overlay anyway); protected dotfiles print last.
        # Both branches must also match -type l: under find's default -P a symlink
        # is neither -type d nor -type f, so a symlinked protected name would be
        # invisible here and never reach _protected_src_ok's refusal.
        _apply_nested_protected() {
            local found rel
            while IFS= read -r -d '' found; do
                rel="${found#"$current_dir"/}"
                case "${found##*/}" in
                    .git)
                        _protect_git "$found" "$workspace/$rel"
                        ;;
                    .vscode|.idea)
                        _protect_dir "$found" "$workspace/$rel"
                        ;;
                    *)
                        _protect_file "$found" "$workspace/$rel"
                        ;;
                esac
            done < <(
                find "$current_dir" -mindepth 2 -maxdepth 3 \
                    \( "${_noise_expr[@]}" \) -prune \
                    -o \
                    \( \( -type d -o -type l \) \( -name .git -o -name .vscode -o -name .idea \) -prune -print0 \) \
                    -o \
                    \( \( -type f -o -type l \) \( "${_dotfile_expr[@]}" \) -print0 \) \
                    2>/dev/null
            )
        }
        _apply_nested_protected
    fi
fi

if [[ "$keep_env_mode" != true ]]; then
    bwrap_args+=(--clearenv)
    bwrap_args+=(--setenv HOME "$HOME")
    bwrap_args+=(--setenv USER "${USER:-${LOGNAME:-root}}")
    bwrap_args+=(--setenv TERM "${TERM:-xterm-256color}")
    _setenv_if_set COLORTERM
fi
# XDG_RUNTIME_DIR, PATH, GOPATH, CARGO_HOME, NVM_DIR/NPM_CONFIG_PREFIX below are set
# unconditionally — even under --keep-env — because they must point at sandbox-mounted
# paths (e.g. /opt/host-bin, /run/user/$sandbox_uid) rather than the host's originals.
bwrap_args+=(--setenv XDG_RUNTIME_DIR "/run/user/$sandbox_uid")
sandbox_path="$HOME/.local/bin:$HOME/go/bin:$HOME/.cargo/bin:$HOME/.bun/bin:/opt/host-bin:/opt/host-cargo-bin:/opt/host-go-bin"
# Node version managers (nvm/fnm). Resolve each manager's active node bin dir, then
# put the manager that is ACTIVE in the launching shell at the FRONT of PATH so
# node/npm/npx resolve to the user's selected version — mirroring how fnm/nvm prepend
# on the host. Otherwise an earlier entry ($HOME/.bun/bin, which often ships a `node`
# shim, or a system node) shadows it. "Active" = the manager whose env var is exported
# in this shell; fnm wins if both are. A merely-installed-but-inactive manager is
# appended as a low-priority fallback so it can't override the user's actual node.
# nvm: $NVM_BIN when active, else the configured default / newest install.
nvm_node_bin=""
if [[ -n "${NVM_BIN:-}" ]]; then
    nvm_node_bin="$NVM_BIN"
elif [[ "$nvm_installed" == true ]]; then
    if [[ -f "$nvm_dir/alias/default" ]]; then
        # Read default version from alias file (contains version string like "v22.21.1")
        nvm_version=$(< "$nvm_dir/alias/default")
        # Handle lts/* aliases (e.g., "lts/iron" -> read actual version from lts alias)
        if [[ "$nvm_version" == lts/* ]]; then
            lts_name="${nvm_version#lts/}"
            [[ -f "$nvm_dir/alias/lts/$lts_name" ]] && nvm_version=$(< "$nvm_dir/alias/lts/$lts_name")
        fi
        [[ -d "$nvm_dir/versions/node/$nvm_version/bin" ]] && nvm_node_bin="$nvm_dir/versions/node/$nvm_version/bin"
    fi
    # Fall back to most recently modified node version (globbing avoids parsing ls output).
    [[ -z "$nvm_node_bin" ]] && _newest_dir nvm_node_bin "$nvm_dir/versions/node"/*/bin
fi
# fnm: $FNM_MULTISHELL_PATH (active in the launching shell, points via
# /run/user/<uid>/fnm_multishells — absent in-sandbox) resolved to its real path under
# $FNM_DIR; fall back to aliases/default, then newest install.
fnm_node_bin=""
if [[ "$fnm_installed" == true ]]; then
    if [[ -n "${FNM_MULTISHELL_PATH:-}" && -d "$FNM_MULTISHELL_PATH/bin" ]]; then
        fnm_node_bin=$(readlink -f "$FNM_MULTISHELL_PATH/bin" 2>/dev/null)
    fi
    if [[ -z "$fnm_node_bin" && -d "$fnm_dir/aliases/default/bin" ]]; then
        fnm_node_bin=$(readlink -f "$fnm_dir/aliases/default/bin" 2>/dev/null)
    fi
    [[ -z "$fnm_node_bin" ]] && _newest_dir fnm_node_bin "$fnm_dir/node-versions"/*/installation/bin
    # Trust only a path that resolves to a real dir inside the mounted $FNM_DIR; drop it otherwise.
    [[ -n "$fnm_node_bin" && ! ( "$fnm_node_bin" == "$fnm_dir"/* && -d "$fnm_node_bin" ) ]] && fnm_node_bin=""
fi
# Front-load the active manager's node bin; append the inactive one as a fallback.
if [[ -n "${FNM_MULTISHELL_PATH:-}" && -n "$fnm_node_bin" ]]; then
    sandbox_path="$fnm_node_bin:$sandbox_path"
    [[ -n "$nvm_node_bin" ]] && sandbox_path="$sandbox_path:$nvm_node_bin"
elif [[ -n "${NVM_BIN:-}" && -n "$nvm_node_bin" ]]; then
    sandbox_path="$nvm_node_bin:$sandbox_path"
    [[ -n "$fnm_node_bin" ]] && sandbox_path="$sandbox_path:$fnm_node_bin"
else
    # No manager active in this shell — append whatever is installed (fallback only).
    [[ -n "$fnm_node_bin" ]] && sandbox_path="$sandbox_path:$fnm_node_bin"
    [[ -n "$nvm_node_bin" ]] && sandbox_path="$sandbox_path:$nvm_node_bin"
fi
# fnm binary itself (curl install lives at $FNM_DIR/fnm) + secondary PM bins. None of
# these provide `node`, so their order doesn't affect node resolution.
[[ "$fnm_installed" == true && -x "$fnm_dir/fnm" ]] && sandbox_path="$sandbox_path:$fnm_dir"
[[ -d "$pnpm_home/bin" ]] && sandbox_path="$sandbox_path:$pnpm_home/bin"
[[ -d "$HOME/.yarn/bin" ]] && sandbox_path="$sandbox_path:$HOME/.yarn/bin"
sandbox_path="$sandbox_path:/usr/local/bin:/usr/bin:/bin:/sbin:/usr/sbin"
bwrap_args+=(--setenv PATH "$sandbox_path")
# Package manager environment variables
bwrap_args+=(--setenv GOPATH "$HOME/go")
bwrap_args+=(--setenv CARGO_HOME "$HOME/.cargo")
# NVM/fnm manage their own npm prefix (inside the version install); only set
# NPM_CONFIG_PREFIX when neither is in use.
[[ "$nvm_installed" == true ]] && bwrap_args+=(--setenv NVM_DIR "$nvm_dir")
[[ "$fnm_installed" == true ]] && bwrap_args+=(--setenv FNM_DIR "$fnm_dir")
if [[ "$nvm_installed" != true && "$fnm_installed" != true ]]; then
    bwrap_args+=(--setenv NPM_CONFIG_PREFIX "$HOME/.local")
fi
# Point pnpm/corepack at their mounted homes so installed tools resolve.
[[ -d "$pnpm_home" ]] && bwrap_args+=(--setenv PNPM_HOME "$pnpm_home")
[[ -d "$corepack_home" ]] && bwrap_args+=(--setenv COREPACK_HOME "$corepack_home")
if [[ "$keep_env_mode" != true ]]; then
    bwrap_args+=(--setenv LANG "${LANG:-C.UTF-8}")
    _setenv_if_set LC_ALL
    _setenv_if_set LC_CTYPE

    # SSH agent forwarding env var (socket validated once at the mount site)
    [[ "$ssh_agent_ok" == true ]] && _setenv_if_set SSH_AUTH_SOCK
fi

# Hardcoded env-var overrides — KEY=VALUE pairs forced into the sandbox,
# never accepted from host env (the passthrough loop below explicitly removes
# them from the whitelist, so they can't drift if added to claude_env_vars
# by accident). CLAUDE_DISABLE_CONFIG_WATCH prevents inotify ENOSPC crashes.
_hardcoded_env_vars=(
    DISABLE_AUTOUPDATER=1 DISABLE_ERROR_REPORTING=1
    DISABLE_BUG_COMMAND=1 CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY=1
    DISABLE_INSTALL_GITHUB_APP_COMMAND=1 CLAUDE_DISABLE_CONFIG_WATCH=1
)
# Telemetry + GrowthBook opt-outs disable the feature-flag layer that gates Remote
# Control eligibility, so they MUST be absent in Remote Control mode (forced unset
# below). Privacy default keeps them on for every normal session.
[[ "$remote_control_mode" != true ]] && \
    _hardcoded_env_vars+=(DO_NOT_TRACK=1 DISABLE_TELEMETRY=1 DISABLE_GROWTHBOOK=1)
for _kv in "${_hardcoded_env_vars[@]}"; do
    bwrap_args+=(--setenv "${_kv%%=*}" "${_kv#*=}")
done
unset _kv

# Hardcoded env-var unsets — forced absent regardless of host env.
# CLAUDE_CODE_SUBPROCESS_ENV_SCRUB triggers permission-mode hardening
# whenever defined (even =0), overriding --dangerously-skip-permissions.
# The CLAUDE_CODE_* / CLAUDE_EFFORT / CLAUDE_PROJECT_DIR markers are set
# by an outer claude process for its subprocess env (ENTRYPOINT/EXECPATH
# identify the parent's binary, SESSION_ID is the parent's UUID,
# BRIDGE_SESSION_ID the parent's Remote Control session ID (2.1.199+),
# CHILD_SESSION=1 marks a nested session (2.1.172+) — inheriting it
# excludes the sandboxed session from --resume/--continue/history,
# breaking blaude -c, TEAM_NAME is the parent's agent-team membership,
# REMOTE/REMOTE_SESSION_ID the parent's claude.ai cloud-session
# identity, EFFORT the parent turn's effort level, PROJECT_DIR the
# parent's cwd, MESSAGING_SOCKET the parent's cross-session inbox socket
# (2.1.224) and PID its process ID (2.1.214)). When blaude is invoked
# from inside another claude session, the ANTHROPIC_*/CLAUDE_* prefix
# passthrough would silently inherit these into the sandboxed inner
# claude — wrong identity, wrong paths (outer binary not reachable
# inside the sandbox), conflated session telemetry. Force-unset so inner
# claude starts clean. Both new markers are re-exported by the inner
# claude for its own subprocesses, so unsetting them is mainly hygiene —
# except that MESSAGING_SOCKET's value stays *live* across the boundary
# (the socket sits under the bind-mounted /tmp), handing sandboxed hooks
# and Bash commands a writable pointer into the host session's inbox,
# and PID names an unrelated process once inside the PID namespace,
# where the Bash tool's pkill self-protection guard reads it.
_hardcoded_unsetenv_vars=(
    CLAUDE_CODE_SUBPROCESS_ENV_SCRUB
    CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_EXECPATH
    CLAUDE_CODE_SESSION_ID CLAUDE_CODE_BRIDGE_SESSION_ID
    CLAUDE_CODE_CHILD_SESSION CLAUDE_CODE_TEAM_NAME
    CLAUDE_CODE_REMOTE CLAUDE_CODE_REMOTE_SESSION_ID
    CLAUDE_EFFORT CLAUDE_PROJECT_DIR
    CLAUDE_CODE_MESSAGING_SOCKET CLAUDE_PID
)
# Remote Control mode: force the telemetry/feature-flag opt-outs absent (so the
# GrowthBook eligibility check can run) plus the auth vars that block RC — it needs
# a full-scope claude.ai OAuth session, so a host ANTHROPIC_API_KEY or limited-scope
# CLAUDE_CODE_OAUTH_TOKEN must not reach the sandbox (either triggers the misleading
# "Remote Control is not yet enabled" error). Listing them here also enters them
# into the passthrough deny-set (built from both arrays below), so the
# ANTHROPIC_*/CLAUDE_* prefix match can't re-pass them.
if [[ "$remote_control_mode" == true ]]; then
    _hardcoded_unsetenv_vars+=(
        DO_NOT_TRACK DISABLE_TELEMETRY DISABLE_GROWTHBOOK
        ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN
    )
fi
for _var in "${_hardcoded_unsetenv_vars[@]}"; do
    bwrap_args+=(--unsetenv "$_var")
done
unset _var

# Auto-passthrough environment variables from host.
# ANTHROPIC_* and CLAUDE_* are matched by prefix in the loop below — the
# Anthropic namespace is owned, so new upstream env vars are picked up
# automatically without churn here. The explicit list covers third-party
# LLM keys, cloud auth, OpenTelemetry/MCP standards, and bare names that
# don't fit either prefix.
claude_env_vars=(
    # Bedrock / AWS auth (Bedrock-specific bearer + standard AWS SDK vars)
    AWS_BEARER_TOKEN_BEDROCK
    AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_REGION AWS_DEFAULT_REGION
    AWS_PROFILE AWS_ROLE_ARN AWS_WEB_IDENTITY_TOKEN_FILE
    # Google Cloud auth (Vertex AI)
    GCLOUD_PROJECT GOOGLE_CLOUD_PROJECT GOOGLE_APPLICATION_CREDENTIALS
    VERTEX_AI_PROJECT_ID VERTEX_AI_API_ENDPOINT
    CLOUD_RUN_JOB_ATTEMPT CLOUD_ML_REGION
    # Vertex region overrides (VERTEX_REGION_DEFAULT, VERTEX_REGION_SMALL_FAST_MODEL,
    # per-model VERTEX_REGION_CLAUDE_*) are matched by the VERTEX_REGION_* glob in
    # the passthrough loop below — enumerating them here required a blaude commit
    # for every new Claude model.
    # GPG (for signed commits — agent socket bound separately under --git)
    GPG_TTY GNUPGHOME
    # MCP standards
    MCP_TIMEOUT MCP_TOOL_TIMEOUT MCP_CONNECT_TIMEOUT_MS MCP_ENABLED
    MCP_OAUTH_CALLBACK_PORT MCP_CLIENT_SECRET ENABLE_TOOL_SEARCH
    ENABLE_CLAUDEAI_MCP_SERVERS MCP_CONNECTION_NONBLOCKING
    MCP_REMOTE_SERVER_CONNECTION_BATCH_SIZE
    MCP_SSE_URL MCP_DISCOVERY_CACHE
    # MCP_SERVER_<SERVER_ID>=<COMMAND> env-based server config — plus the
    # MCP_SERVER_CONNECTION_BATCH_SIZE tunable — are matched by the MCP_SERVER_*
    # glob in the passthrough loop below, so neither is listed explicitly here.
    # (MCP_REMOTE_SERVER_* does not match that glob, hence its explicit entry above.)
    # OpenTelemetry exporter + W3C trace context
    OTEL_METRICS_EXPORTER OTEL_LOGS_EXPORTER OTEL_TRACES_EXPORTER
    OTEL_EXPORTER_OTLP_PROTOCOL OTEL_EXPORTER_OTLP_ENDPOINT OTEL_EXPORTER_OTLP_HEADERS
    OTEL_EXPORTER_OTLP_METRICS_PROTOCOL OTEL_EXPORTER_OTLP_METRICS_ENDPOINT
    OTEL_EXPORTER_OTLP_LOGS_PROTOCOL OTEL_EXPORTER_OTLP_LOGS_ENDPOINT
    OTEL_EXPORTER_OTLP_TRACES_PROTOCOL OTEL_EXPORTER_OTLP_TRACES_ENDPOINT
    # Generic grpc OTLP credentials; the per-signal METRICS_* variants override
    # them. All five name files — bound read-only in the mTLS loop above.
    OTEL_EXPORTER_OTLP_CLIENT_KEY OTEL_EXPORTER_OTLP_CLIENT_CERTIFICATE
    OTEL_EXPORTER_OTLP_CERTIFICATE
    OTEL_EXPORTER_OTLP_METRICS_CLIENT_KEY OTEL_EXPORTER_OTLP_METRICS_CLIENT_CERTIFICATE
    OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE
    OTEL_METRIC_EXPORT_INTERVAL OTEL_LOGS_EXPORT_INTERVAL OTEL_TRACES_EXPORT_INTERVAL
    OTEL_LOG_USER_PROMPTS OTEL_LOG_ASSISTANT_RESPONSES OTEL_LOG_TOOL_DETAILS OTEL_LOG_TOOL_CONTENT
    OTEL_METRICS_INCLUDE_SESSION_ID OTEL_METRICS_INCLUDE_VERSION OTEL_METRICS_INCLUDE_ACCOUNT_UUID
    OTEL_METRICS_INCLUDE_ENTRYPOINT OTEL_METRICS_INCLUDE_RESOURCE_ATTRIBUTES
    OTEL_RESOURCE_ATTRIBUTES OTEL_LOG_RAW_API_BODIES
    # Standard OTel SDK attribute-length caps (Claude Code 2.1.214+); the per-signal
    # LOGRECORD/SPAN variants are read the same way.
    OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT
    OTEL_LOGRECORD_ATTRIBUTE_VALUE_LENGTH_LIMIT OTEL_SPAN_ATTRIBUTE_VALUE_LENGTH_LIMIT
    TRACEPARENT TRACESTATE
    # Bash / shell tool tunables
    BASH_DEFAULT_TIMEOUT_MS BASH_MAX_OUTPUT_LENGTH BASH_MAX_TIMEOUT_MS
    # Token & retry limits
    MAX_THINKING_TOKENS MAX_MCP_OUTPUT_TOKENS MAX_STRUCTURED_OUTPUT_RETRIES
    TASK_MAX_OUTPUT_LENGTH SLASH_COMMAND_TOOL_CHAR_BUDGET API_TIMEOUT_MS API_FORCE_IDLE_TIMEOUT
    FALLBACK_FOR_ALL_PRIMARY_MODELS
    # Network & TLS
    HTTP_PROXY HTTPS_PROXY SOCKS_PROXY NO_PROXY
    # CLAUDE_CODE_CERT_STORE (bundled,system) superseded the old
    # USE_BUILTIN_CA_BUNDLE/USE_SYSTEM_CA toggles and rides the CLAUDE_* prefix.
    NODE_EXTRA_CA_CERTS NODE_TLS_REJECT_UNAUTHORIZED
    # Updates & installation toggles
    FORCE_AUTOUPDATE_PLUGINS DISABLE_INSTALLATION_CHECKS DISABLE_UPDATES
    DISABLE_UPGRADE_COMMAND DISABLE_DOCTOR_COMMAND DISABLE_EXTRA_USAGE_COMMAND
    DISABLE_LOGIN_COMMAND DISABLE_LOGOUT_COMMAND DISABLE_FEEDBACK_COMMAND
    # Caching & compaction toggles. DISABLE_PROMPT_CACHING and its per-model
    # DISABLE_PROMPT_CACHING_<MODEL> variants are matched by the
    # DISABLE_PROMPT_CACHING* glob in the passthrough loop below (same
    # new-model churn as VERTEX_REGION_*).
    DISABLE_NON_ESSENTIAL_MODEL_CALLS
    DISABLE_AUTO_COMPACT DISABLE_COMPACT DISABLE_INTERLEAVED_THINKING
    ENABLE_PROMPT_CACHING_1H ENABLE_PROMPT_CACHING_1H_BEDROCK FORCE_PROMPT_CACHING_5M
    # Runtime indicators (set by Claude Code itself or external tooling) and misc
    IS_DEMO FORCE_HYPERLINK USE_BUILTIN_RIPGREP CCR_FORCE_BUNDLE
    CLAUDECODE AI_AGENT DEBUG DISABLE_COST_WARNINGS
    # Generic terminal/CI signals: CI affects print-mode (-p) Bedrock/Vertex/Foundry
    # auth fallback; NO_COLOR/FORCE_COLOR apply to spawned subprocesses, not the UI.
    CI NO_COLOR FORCE_COLOR
    # Terminal identity (Warp/zap claude-code-warp extension gates notifications
    # on these; WARP_* itself is matched by the glob below). TERM_PROGRAM also
    # lets Claude Code apply its own terminal-specific behavior.
    TERM_PROGRAM TERM_PROGRAM_VERSION
    # Additional LLM API keys (for MCP servers and tools that may use them)
    OPENAI_API_KEY OPENAI_API_BASE OPENAI_ORG_ID
    AZURE_OPENAI_API_KEY AZURE_OPENAI_ENDPOINT AZURE_OPENAI_API_VERSION
    GOOGLE_API_KEY GEMINI_API_KEY
    MISTRAL_API_KEY COHERE_API_KEY HUGGINGFACE_API_KEY HF_TOKEN
    GROQ_API_KEY TOGETHER_API_KEY REPLICATE_API_TOKEN
    PERPLEXITY_API_KEY FIREWORKS_API_KEY DEEPSEEK_API_KEY XAI_API_KEY
    JINA_API_KEY EXA_API_KEY
    # Third-party service tokens (for MCP servers and tools)
    FEEDLY_ACCESS_TOKEN RAINDROP_ACCESS_TOKEN
    # claudechic environment variables
    CLAUDECHIC_DEBUG CLAUDECHIC_REMOTE_PORT CHIC_PROFILE CHIC_SAMPLE_THRESHOLD
    # notebooklm-mcp environment variables
    NOTEBOOKLM_COOKIES NOTEBOOKLM_CSRF_TOKEN NOTEBOOKLM_SESSION_ID
    NOTEBOOKLM_MCP_TRANSPORT NOTEBOOKLM_MCP_HOST NOTEBOOKLM_MCP_PORT
    NOTEBOOKLM_MCP_DEBUG NOTEBOOKLM_QUERY_TIMEOUT NOTEBOOKLM_BL
)
# Only passthrough specific vars when environment is cleared (default).
# Single pass over exported env vars, matched against the whitelist set,
# the ANTHROPIC_*/CLAUDE_* prefixes, and the legacy glob patterns.
if [[ "$keep_env_mode" != true ]]; then
    declare -A _env_whitelist _env_denylist
    for var in "${claude_env_vars[@]}"; do _env_whitelist[$var]=1; done
    # Build deny-set from hardcoded vars — they're forced (set or unset)
    # above and must never be overridden from the host env, even via the
    # ANTHROPIC_*/CLAUDE_* prefix match. %%=* is a no-op on the bare-name
    # entries from _hardcoded_unsetenv_vars.
    for _kv in "${_hardcoded_env_vars[@]}" "${_hardcoded_unsetenv_vars[@]}"; do
        _env_denylist[${_kv%%=*}]=1
    done
    unset _kv

    while IFS= read -r name; do
        [[ -n "${_env_denylist[$name]:-}" ]] && continue
        if [[ -n "${_env_whitelist[$name]:-}" || \
              "$name" == ANTHROPIC_* || "$name" == CLAUDE_* || \
              "$name" == VERTEX_REGION_* || "$name" == DISABLE_PROMPT_CACHING* || \
              "$name" == WARP_* || "$name" == MCP_SERVER_* || \
              "$name" == *_WEBHOOK || "$name" == WEBSHARE_* ]]; then
            _setenv_if_set "$name"
        fi
    done < <(compgen -e)
    unset _env_whitelist _env_denylist

    # D-Bus session bus address (only with --keyring flag)
    [[ "$keyring_mode" == true ]] && _setenv_if_set DBUS_SESSION_BUS_ADDRESS
fi

for env_spec in "${env_args[@]}"; do
    key="${env_spec%%=*}"
    value="${env_spec#*=}"
    bwrap_args+=(--setenv "$key" "$value")
done

# --- Build command ---

if [[ "$exec_mode" == true ]]; then
    # --exec: run arbitrary command
    bwrap_args+=("${command_args[@]}")
elif [[ "$chic_mode" == true ]]; then
    # --chic: run claudechic instead of claude (an empty command_args expands to nothing)
    bwrap_args+=(claudechic --dangerously-skip-permissions "${command_args[@]}")
elif [[ "$rc_subcommand" == true ]]; then
    # `claude remote-control` (server mode) is a subcommand that must be the first
    # token and rejects --dangerously-skip-permissions (Remote Control enforces
    # permission prompts regardless). Forward it verbatim without that flag.
    bwrap_args+=(claude "${command_args[@]}")
elif [[ ${#command_args[@]} -eq 0 ]]; then
    # No args: interactive claude (or -p for piped input)
    if [[ -t 0 ]]; then
        bwrap_args+=(claude --dangerously-skip-permissions)
    else
        # Piped input with no command - send to claude -p
        bwrap_args+=(claude --dangerously-skip-permissions -p)
    fi
else
    # Pass accumulated args to claude
    bwrap_args+=(claude --dangerously-skip-permissions "${command_args[@]}")
fi

# --- Execute ---

# Overlays unavailable: host state that would normally be write-discarding had to
# stay writable. Warn rather than fail — blaude always launches. Emitted here,
# above the --debug/--dry-run command dump and ahead of the warnings further down,
# because --dry-run exits before those and this one explains the mounts it printed.
# Covers only the *capability* gap: if overlayfs is supported but refuses to mount
# on this filesystem (some WSL2 drvfs or NFS homes) bwrap aborts, and
# --allow-protected-writes is the escape hatch.
if [[ ${#_overlay_fallback_paths[@]} -gt 0 ]]; then
    if [[ "$_overlay_probe_failed" == true ]]; then
        echo "Warning: could not ask $_bwrap_bin whether it supports --tmp-overlay;" >&2
        echo "  assuming not, for this run only." >&2
    else
        echo "Warning: bwrap lacks --tmp-overlay (needs 0.8.0+)." >&2
    fi
    echo "  These stay host-writable:" >&2
    printf '  %s\n' "${_overlay_fallback_paths[@]}" >&2
    echo "" >&2
fi

if [[ "$debug" == true ]]; then
    # printf %q emits a shell-safe, copy-pasteable representation for every
    # metacharacter (space, quote, $, `, \, glob chars, ...).
    printf '\e[2mbwrap' >&2
    printf ' %q' "${bwrap_args[@]}" >&2
    printf '\e[0m\n' >&2
fi

if [[ "$dry_run" == true ]]; then
    exit 0
fi

# Pause asciinema recording during the sandbox session
_asciinema_pid=""
if [[ "${ASCIINEMA_REC:-}" == "1" ]]; then
    _asciinema_pid=$(_find_asciinema_pid)
    if [[ -n "$_asciinema_pid" ]]; then
        _dbg "Pausing asciinema (PID $_asciinema_pid)"
    fi
fi

# Auto-detect osc52-clipboard wrapper (intercepts OSC 52 sequences for VTE terminals
# that lack native OSC 52 support, e.g. Terminator, GNOME Terminal, XFCE Terminal)
_clipboard_cmd=""
if [[ "$no_clipboard" != true ]]; then
    # Derive blaude's directory without forking readlink on the common case.
    # readlink is only needed when $0 is a symlink (rare — e.g. installed to
    # /usr/local/bin via `ln -s`).
    if [[ -L "$0" ]]; then
        _blaude_dir=$(readlink -f "$0")
        _blaude_dir=${_blaude_dir%/*}
    elif [[ "$0" == */* ]]; then
        _blaude_dir="${0%/*}"
    else
        _blaude_dir=""  # bare name via PATH — fall through to command -v
    fi
    if [[ -n "$_blaude_dir" && -x "$_blaude_dir/osc52-clipboard" ]]; then
        _clipboard_cmd="$_blaude_dir/osc52-clipboard"
    else
        _clipboard_cmd=$(command -v osc52-clipboard 2>/dev/null || true)
    fi
fi
if [[ -n "$_clipboard_cmd" ]]; then
    _dbg "Clipboard proxy: $_clipboard_cmd"
    final_cmd=("$_clipboard_cmd" bwrap "${bwrap_args[@]}")
else
    final_cmd=(bwrap "${bwrap_args[@]}")
fi

# Detect AppArmor user namespace restriction (Ubuntu 24.04+).
# bwrap needs user namespaces, which AppArmor may block by default.
# _apparmor_restricts_userns requires /proc/sys/kernel/apparmor_restrict_unprivileged_userns
# to exist and be "1" — true only on AppArmor-active systems, so short-circuits for free.
if _apparmor_restricts_userns && [[ ! -f /etc/apparmor.d/bwrap ]]; then
    echo "Warning: AppArmor is restricting unprivileged user namespaces." >&2
    echo "  bwrap may fail with 'Operation not permitted' on this system." >&2
    echo "  Fix with: blaude fix-apparmor" >&2
    echo "" >&2
fi

# WSL2 workarounds: mitigate 9P/drvfs race conditions
# The 9P filesystem used for /mnt/* host mounts has known bugs (still unfixed):
#   - https://github.com/microsoft/WSL/issues/8443 (fstat ENOENT after rename)
#   - https://github.com/microsoft/WSL/issues/13105 (follow-up, still open)
# The only reliable fix is to use the native ext4 filesystem (/home/...) instead.
if [[ "$wsl_mode" == true ]]; then
    _dbg "WSL2 detected: applying workarounds"

    # Warn if workspace is on Windows filesystem (9P) - once per session
    # Intentionally in /tmp, not $_cache_dir: a UX "warned once" flag, not
    # trusted input — only its existence is checked, so a forged flag merely
    # suppresses a warning. The per-reboot reset (/tmp cleared on boot) is wanted.
    wsl_mnt_warned="/tmp/blaude-mnt-warned-${_host_uid}"
    if [[ "$current_dir" == /mnt/* && ! -f "$wsl_mnt_warned" ]]; then
        echo "Warning: Workspace is on Windows filesystem (/mnt/*)." >&2
        echo "  WSL2's 9P protocol has known bugs causing spurious ENOENT errors." >&2
        echo "  For best reliability, move your project to the Linux filesystem:" >&2
        echo "  e.g., /home/\$USER/projects/ instead of /mnt/c/..." >&2
        echo "" >&2
        read -n 1 -s -r -p "Press any key to continue..." >&2
        echo "" >&2
        : > "$wsl_mnt_warned" 2>/dev/null || true
    fi

    sync
fi

# Non-exec path: WSL2 needs post-bwrap sync, asciinema needs post-bwrap SIGCONT.
# Both require blaude to stay alive after bwrap exits, so we can't exec.
if [[ "$wsl_mode" == true || -n "${_asciinema_pid:-}" ]]; then
    _blaude_exit() {
        [[ "$wsl_mode" == true ]] && sync
        [[ -n "${_asciinema_pid:-}" ]] && kill -CONT "$_asciinema_pid" 2>/dev/null
    }
    trap _blaude_exit EXIT
    [[ -n "${_asciinema_pid:-}" ]] && kill -STOP "$_asciinema_pid" 2>/dev/null
    "${final_cmd[@]}"
    exit $?
fi

exec "${final_cmd[@]}"
