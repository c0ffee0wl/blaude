# Only passthrough specific vars when environment is cleared (default)
if [[ "$keep_env_mode" != true ]]; then
    for var in "${claude_env_vars[@]}"; do
        if [[ -n "${!var:-}" ]]; then
            bwrap_args+=(--setenv "$var" "${!var}")
        fi
    done

    # Auto-passthrough any *_WEBHOOK and WEBSHARE_* environment variables
    while IFS='=' read -r name value; do
        [[ "$name" == *_WEBHOOK || "$name" == WEBSHARE_* ]] && bwrap_args+=(--setenv "$name" "$value")
    done < <(env)

    # D-Bus session bus address (only with --keyring flag)
    if [[ "$keyring_mode" == true && -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
        bwrap_args+=(--setenv DBUS_SESSION_BUS_ADDRESS "$DBUS_SESSION_BUS_ADDRESS")
    fi
fi

# User-specified environment variables
for env_spec in "${env_args[@]}"; do
    key="${env_spec%%=*}"
    value="${env_spec#*=}"
    bwrap_args+=(--setenv "$key" "$value")
done

# --- Build command ---

if [[ "$exec_mode" == true ]]; then
    # --exec: run arbitrary command
    bwrap_args+=("${command_args[@]}")
elif [[ "$chic_mode" == true ]]; then
    # --chic: run claudechic instead of claude
    if [[ ${#command_args[@]} -eq 0 ]]; then
        bwrap_args+=(claudechic --dangerously-skip-permissions)
    else
        bwrap_args+=(claudechic --dangerously-skip-permissions "${command_args[@]}")
    fi
elif [[ ${#command_args[@]} -eq 0 ]]; then
    # No args: interactive claude (or -p for piped input)
    if [[ -t 0 ]]; then
        bwrap_args+=(claude --dangerously-skip-permissions)
    else
        # Piped input with no command - send to claude -p
        bwrap_args+=(claude --dangerously-skip-permissions -p)
    fi
else
    # Pass accumulated args to claude
    bwrap_args+=(claude --dangerously-skip-permissions "${command_args[@]}")
fi

# --- Execute ---

if [[ "$debug" == true ]]; then
    # Print command in a way that can be copy-pasted
    printf '\e[2mbwrap' >&2
    for arg in "${bwrap_args[@]}"; do
        if [[ "$arg" == *" "* || "$arg" == *"'"* ]]; then
            printf ' "%s"' "$arg" >&2
        else
            printf ' %s' "$arg" >&2
        fi
    done
    printf '\e[0m\n' >&2
fi

if [[ "$dry_run" == true ]]; then
    exit 0
fi

# Detect AppArmor user namespace restriction (Ubuntu 24.04+)
# bwrap needs user namespaces, which AppArmor may block by default
if command -v apparmor_parser &>/dev/null && \
   [[ -d /sys/module/apparmor ]] && \
   [[ -f /proc/sys/kernel/apparmor_restrict_unprivileged_userns ]] && \
   [[ "$(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns)" == "1" ]] && \
   [[ ! -f /etc/apparmor.d/bwrap ]]; then
    echo "Warning: AppArmor is restricting unprivileged user namespaces." >&2
    echo "  bwrap may fail with 'Operation not permitted' on this system." >&2
    echo "  Fix with: blaude fix-apparmor" >&2
    echo "" >&2
fi

# WSL2 workarounds: mitigate 9P/drvfs race conditions
# The 9P filesystem used for /mnt/* host mounts has known bugs (still unfixed):
#   - https://github.com/microsoft/WSL/issues/8443 (fstat ENOENT after rename)
#   - https://github.com/microsoft/WSL/issues/13105 (follow-up, still open)
# The only reliable fix is to use the native ext4 filesystem (/home/...) instead.
if [[ "$wsl_mode" == true ]]; then
    [[ "$debug" == true ]] && echo "WSL2 detected: applying workarounds" >&2

    # Warn if workspace is on Windows filesystem (9P) - once per session
    wsl_mnt_warned="/tmp/blaude-mnt-warned-${UID:-$(id -u)}"
    if [[ "$current_dir" == /mnt/* && ! -f "$wsl_mnt_warned" ]]; then
        echo "Warning: Workspace is on Windows filesystem (/mnt/*)." >&2
        echo "  WSL2's 9P protocol has known bugs causing spurious ENOENT errors." >&2
        echo "  For best reliability, move your project to the Linux filesystem:" >&2
        echo "  e.g., /home/\$USER/projects/ instead of /mnt/c/..." >&2
        echo "" >&2
        read -n 1 -s -r -p "Press any key to continue..." >&2
        echo "" >&2
        touch "$wsl_mnt_warned" 2>/dev/null || true
    fi

    sync
    trap 'sync' EXIT
    exec bwrap "${bwrap_args[@]}"
fi

exec bwrap "${bwrap_args[@]}"
