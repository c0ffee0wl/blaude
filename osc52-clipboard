#!/usr/bin/env python3
"""PTY proxy that intercepts OSC 52 clipboard sequences and copies via xsel/xclip/wl-copy.

All output passes through unchanged, but OSC 52 sequences are additionally
decoded and sent to the system clipboard. Designed for terminals that don't
support OSC 52 (e.g. VTE-based: Terminator, GNOME Terminal).

Requires Python 3.9+ (for os.waitstatus_to_exitcode).

Usage: osc52-clipboard <command> [args...]
"""
import base64
import fcntl
import os
import pty
import select
import shutil
import signal
import subprocess
import sys
import termios
import tty

_CLIPBOARD_TIMEOUT = 3  # seconds — prevent terminal freeze on broken clipboard tools


# --- Clipboard backend detection ---

def _detect_clipboard():
    """Detect available clipboard command. Returns arg list or None."""
    if os.environ.get("WAYLAND_DISPLAY") and shutil.which("wl-copy"):
        return ["wl-copy"]
    if os.environ.get("DISPLAY"):
        if shutil.which("xclip"):
            return ["xclip", "-selection", "clipboard"]
        if shutil.which("xsel"):
            return ["xsel", "--clipboard", "--input"]
    if shutil.which("pbcopy"):
        return ["pbcopy"]
    return None


def _copy_to_clipboard(payload, clip_cmd):
    """Decode base64 payload and send to clipboard."""
    try:
        text = base64.b64decode(payload).decode("utf-8", errors="replace")
        subprocess.run(clip_cmd, input=text.encode(), check=False,
                       timeout=_CLIPBOARD_TIMEOUT,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


# --- OSC 52 state machine scanner ---

_PASSTHROUGH = 0
_SAW_ESC = 1
_IN_OSC = 2
_IN_PAYLOAD = 3
_PAYLOAD_ESC = 4  # ESC seen inside payload — could be ST terminator or broken sequence


class _OSC52Scanner:
    """Scans byte stream for OSC 52 sequences. Observe-only — never modifies data."""

    __slots__ = ("state", "buf", "clip_cmd")

    def __init__(self, clip_cmd):
        self.state = _PASSTHROUGH
        self.buf = bytearray()
        self.clip_cmd = clip_cmd

    def feed(self, data):
        # Fast path: PASSTHROUGH chunks with no ESC byte (vast majority of terminal output)
        if self.state == _PASSTHROUGH:
            idx = data.find(0x1B)
            if idx == -1:
                return
            if idx > 0:
                data = data[idx:]
        self._scan(data)

    def _scan(self, data):
        i = 0
        n = len(data)
        while i < n:
            # Payload is the hot path: base64 clipboard content can be large.
            # Use bytes.find() (C-level) to skip to the next terminator byte.
            if self.state == _IN_PAYLOAD:
                bel = data.find(0x07, i)
                esc = data.find(0x1B, i)
                if bel == -1:
                    j = n if esc == -1 else esc
                elif esc == -1:
                    j = bel
                else:
                    j = bel if bel < esc else esc
                space = 1_048_576 - len(self.buf)  # 1 MB safety cap
                chunk = j - i
                if chunk > space:
                    self.state = _PASSTHROUGH
                    self.buf.clear()
                    i = j
                    continue
                if chunk:
                    self.buf.extend(data[i:j])
                i = j
                if i >= n:
                    return
                b = data[i]
                i += 1
                if b == 0x07:
                    self._finish()
                else:  # 0x1B
                    self.state = _PAYLOAD_ESC
                continue

            b = data[i]
            i += 1
            if self.state == _PASSTHROUGH:
                if b == 0x1B:
                    self.state = _SAW_ESC
            elif self.state == _SAW_ESC:
                if b == 0x5D:  # ']'
                    self.state = _IN_OSC
                    self.buf.clear()
                else:
                    self.state = _PASSTHROUGH
            elif self.state == _IN_OSC:
                self.buf.append(b)
                bl = len(self.buf)
                # Match "52;" incrementally (avoids per-byte bytes(self.buf) copy)
                if bl <= 3:
                    if self.buf[-1] != b"52;"[bl - 1]:
                        self.state = _PASSTHROUGH
                        self.buf.clear()
                elif b == 0x3B:  # ';' ends the selector field; payload begins
                    self.buf.clear()
                    self.state = _IN_PAYLOAD
                elif b == 0x07 or (b == 0x5C and self.buf[-2] == 0x1B):
                    # BEL or ST (ESC \) terminates an aborted OSC header
                    self.state = _PASSTHROUGH
                    self.buf.clear()
                elif bl > 16:
                    self.state = _PASSTHROUGH
                    self.buf.clear()
            elif self.state == _PAYLOAD_ESC:
                if b == 0x5C:  # '\\' — ST terminator (ESC + backslash)
                    self._finish()
                elif b == 0x5D:  # ']' — new OSC starting
                    self.buf.clear()
                    self.state = _IN_OSC
                else:
                    self.buf.clear()
                    self.state = _PASSTHROUGH

    def _finish(self):
        _copy_to_clipboard(bytes(self.buf), self.clip_cmd)
        self.state = _PASSTHROUGH
        self.buf.clear()


# --- PTY proxy with SIGWINCH support ---

def _proxy(argv, master_read):
    """Spawn a child in a PTY with bidirectional I/O relay and SIGWINCH forwarding."""
    child_pid, master_fd = pty.fork()
    if child_pid == 0:
        os.execvp(argv[0], argv)

    real_stdin = sys.stdin.fileno()
    real_stdout = sys.stdout.fileno()

    def _copy_winsize():
        try:
            winsize = fcntl.ioctl(real_stdout, termios.TIOCGWINSZ, b"\x00" * 8)
            fcntl.ioctl(master_fd, termios.TIOCSWINSZ, winsize)
        except OSError:
            pass

    _copy_winsize()
    signal.signal(signal.SIGWINCH, lambda *_: _copy_winsize())

    # Set real terminal to raw mode
    try:
        old_attrs = termios.tcgetattr(real_stdin)
        tty.setraw(real_stdin)
        restore = True
    except termios.error:
        restore = False

    try:
        fds = [real_stdin, master_fd]
        while fds:
            try:
                rlist, _, _ = select.select(fds, [], [])
            except InterruptedError:
                continue  # SIGWINCH interrupts select — just retry

            if master_fd in rlist:
                try:
                    data = master_read(master_fd)
                except OSError:
                    break
                if not data:
                    break
                os.write(real_stdout, data)

            if real_stdin in rlist:
                try:
                    data = os.read(real_stdin, 16384)
                except OSError:
                    fds.remove(real_stdin)
                    continue
                if not data:
                    fds.remove(real_stdin)
                else:
                    try:
                        os.write(master_fd, data)
                    except OSError:
                        break
    finally:
        if restore:
            termios.tcsetattr(real_stdin, termios.TCSAFLUSH, old_attrs)
        os.close(master_fd)

    _, status = os.waitpid(child_pid, 0)
    return status


# --- Main ---

def main():
    if len(sys.argv) < 2:
        print(f"Usage: {sys.argv[0]} <command> [args...]", file=sys.stderr)
        sys.exit(1)

    if os.environ.get("OSC52_NO_CLIPBOARD") == "1":
        os.execvp(sys.argv[1], sys.argv[1:])

    clip_cmd = _detect_clipboard()
    if clip_cmd is None:
        print("osc52-clipboard: no clipboard tool found (need xclip, xsel, or wl-copy)", file=sys.stderr)
        os.execvp(sys.argv[1], sys.argv[1:])

    scanner = _OSC52Scanner(clip_cmd)

    def master_read(fd):
        data = os.read(fd, 16384)
        scanner.feed(data)
        return data

    status = _proxy(sys.argv[1:], master_read)
    sys.exit(os.waitstatus_to_exitcode(status))


if __name__ == "__main__":
    main()
